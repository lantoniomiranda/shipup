<% breadcrumbs [ "Workspace", root_path ], "Account" %>
<% identity = @user.identities.first %>
<% preference = @user.preference %>

<%= form_with model: @user, url: account_path, method: :patch, class: "account", data: { controller: "dirty-form " } do |form| %>
  <header class="page-header">
    <div class="page-header__heading"><h1>Your account</h1></div>
    <div class="page-header__actions">
      <span class="tag tag--unsaved" data-dirty-form-target="flag" hidden><%= icon "pencil", size: 13 %>Unsaved changes</span>
      <%= link_to appearance_path, class: "btn" do %><%= icon "palette" %><span>Appearance</span><% end %>
      <%= link_to account_path, class: "btn", data: { hotkey: "escape" } do %><span>Discard</span><%= render "shared/key", label: "Esc" %><% end %>
      <button type="submit" class="btn btn--primary" data-hotkey="ctrl+enter"><%= icon "check" %><span>Save changes</span><%= render "shared/key", label: "Ctrl Enter" %></button>
    </div>
  </header>

  <div class="account__grid">
    <section class="card-panel profile">
      <div class="profile__head">
        <span class="profile__avatar avatar--<%= @user.avatar_color %>" data-dirty-form-target="avatarPreview"><%= icon @user.avatar_icon, size: 44 %></span>
        <div>
          <h2><%= @user.name %></h2>
          <span class="tag tag--role"><%= icon "shield", size: 13 %><%= @roles %></span>
        </div>
      </div>

      <div class="field">
        <%= form.label :name, "Display name", class: "eyebrow" %>
        <%= form.text_field :name, class: "input", required: true %>
      </div>

      <fieldset class="field">
        <legend class="eyebrow">Avatar</legend>
        <div class="avatar-grid">
          <% User::AVATAR_ICONS.each do |name| %>
            <label class="avatar-option"><%= form.radio_button :avatar_icon, name, class: "avatar-option__input", data: { action: "dirty-form#preview", icon: name } %><span><%= icon name, size: 22 %></span></label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="field">
        <legend class="eyebrow">Color</legend>
        <div class="swatches">
          <% Hued::HUES.each do |hue| %>
            <label class="swatch swatch--<%= hue %>"><%= form.radio_button :avatar_color, hue, class: "swatch__input", data: { action: "dirty-form#preview", hue: hue } %><span><%= icon "check", size: 16 %></span></label>
          <% end %>
        </div>
      </fieldset>

      <div class="signin-note">
        <%= icon(identity&.provider == "microsoft" ? "microsoft" : "google", size: 20) %>
        <div><strong>Signed in with <%= (identity&.provider || "Google").capitalize %></strong><small><%= @user.email %> · no password to manage</small></div>
        <%= icon "lock", size: 16 %>
      </div>
    </section>

    <section class="card-panel notifications">
      <header class="notifications__head">
        <h2>Email notifications</h2>
      </header>
      <p class="eyebrow notifications__label">When this happens</p>
      <ul class="settings-list">
        <% { "mention_or_reply" => [ "Mentions and replies", "Someone @-mentions you or answers your topic" ],
             "new_topic" => [ "New topics in my projects", "Issues and features opened by teammates" ],
             "similar_topic" => [ "Similar-topic alerts", "Sounds like something we've already talked about" ],
             "task_assigned" => [ "Tasks assigned to me", "Including tasks created from topics" ],
             "subtask_unlocked" => [ "My subtask is unlocked", "The previous step in a chain was completed" ],
             "meeting_invite" => [ "Meeting invites", "A manager picks topics you are part of" ] }.each do |kind, (title, hint)| %>
          <li>
            <div><strong><%= title %></strong><small><%= hint %></small></div>
            <%= hidden_field_tag "notifications[#{kind}]", "0", id: nil %>
            <%= check_box_tag "notifications[#{kind}]", "1", @user.subscribed_to?(kind), class: "switch" %>
          </li>
        <% end %>
      </ul>

      <div class="field-row field-row--timing">
        <fieldset class="field">
          <legend class="eyebrow">Email timing</legend>
          <div class="choice">
            <% UserPreference::EMAIL_FREQUENCIES.each do |frequency| %>
              <label class="choice__option"><%= radio_button_tag "preference[email_frequency]", frequency, preference.email_frequency == frequency, class: "choice__input" %><span><%= frequency.humanize %></span></label>
            <% end %>
          </div>
        </fieldset>
        <div class="field">
          <p class="eyebrow">Quiet hours · <%= @user.time_zone %></p>
          <div class="quiet-hours">
            <%= icon "moon", size: 15 %>
            <%= time_field_tag "preference[quiet_hours_start]", preference.quiet_hours_start.strftime("%H:%M"), class: "input input--time", "aria-label": "Quiet hours start" %>–
            <%= time_field_tag "preference[quiet_hours_end]", preference.quiet_hours_end.strftime("%H:%M"), class: "input input--time", "aria-label": "Quiet hours end" %>
          </div>
        </div>
      </div>
    </section>
  </div>
<% end %>
