<% project_header @project, active: :clients %>

<%= form_with url: project_clients_path(@project), class: "split" do |form| %>
  <section class="panel panel--form">
    <header class="panel__bar">
      <%= link_to project_clients_path(@project), class: "thread__back", data: { **hotkey_data(:back) } do %>
        <%= icon "arrow-left" %><span><%= t("clients.back") %></span><%= key_hint(:back) %>
      <% end %>
    </header>

    <div class="form">
      <header class="form__heading">
        <h1><%= t("clients.title") %></h1>
        <p><%= t("clients.intro") %></p>
      </header>

      <div class="field-row">
        <div class="field">
          <%= label_tag :company, t("common.company"), class: "eyebrow" %>
          <%= text_field_tag :company, params[:company], class: "input", required: true, autofocus: true, autocomplete: "organization" %>
        </div>
        <div class="field">
          <%= label_tag :contact_name, t("clients.contact_name"), class: "eyebrow" %>
          <%= text_field_tag :contact_name, params[:contact_name], class: "input", required: true, autocomplete: "name" %>
        </div>
      </div>

      <div class="field" data-controller="tags">
        <%= label_tag :email_entry, t("clients.emails"), class: "eyebrow" %>
        <div class="tag-input" data-action="click->tags#focus">
          <% Array(params[:emails]).each do |email| %>
            <span class="tag" data-tags-target="item"><%= email %><input type="hidden" name="emails[]" value="<%= email %>"><button type="button" data-action="tags#remove" aria-label="<%= t("clients.remove_email", email: email) %>"><%= icon "x", size: 12 %></button></span>
          <% end %>
          <input type="email" id="email_entry" class="tag-input__entry" placeholder="<%= t("clients.email_placeholder") %>" data-tags-target="entry" data-action="keydown->tags#keydown blur->tags#commit">
        </div>
        <template data-tags-target="template"><span class="tag" data-tags-target="item">EMAIL<input type="hidden" name="emails[]" value="EMAIL"><button type="button" data-action="tags#remove" aria-label="<%= t("clients.remove_email", email: "EMAIL") %>"><%= icon "x", size: 12 %></button></span></template>
      </div>
    </div>

    <footer class="panel__footer">
      <%= link_to project_clients_path(@project), class: "btn" do %><span><%= t("common.cancel") %></span><%= key_hint(:back) %><% end %>
      <button type="submit" class="btn btn--primary" data-hotkey="<%= Keybindings.keys(:submit) %>">
        <%= icon "user-plus" %><span><%= t("clients.add") %></span><%= key_hint(:submit) %>
      </button>
    </footer>
  </section>

  <aside class="side side--wide side--padded">
    <h3 class="eyebrow"><%= t("clients.in_project") %></h3>
    <ul class="client-list">
      <% @clients.each do |client| %>
        <li><span class="client-tile client-tile--<%= client_hue(client) %>"><%= client.initials %></span><strong><%= client.name %></strong></li>
      <% end %>
      <% if @clients.empty? %><li class="entries__empty"><%= t("common.none_yet") %></li><% end %>
    </ul>
  </aside>
<% end %>
