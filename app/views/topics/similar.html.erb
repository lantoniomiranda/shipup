<%= turbo_frame_tag "similar_topics" do %>
  <% if @similar.blank? && @query.length >= 3 %><p class="similar__empty"><%= t("topics.no_similar") %></p><% end %>
  <% @similar.each_with_index do |topic, index| %>
    <%= link_to project_topic_path(@project, topic), class: "similar #{"similar--best" if index.zero?}", target: "_top" do %>
      <div class="similar__head"><strong><%= topic.title %></strong><span><%= topic.match_percent %>%</span></div>
      <div class="meter"><span style="width: <%= topic.match_percent %>%"></span></div>
      <p><%= t("enums.topic_status.#{topic.status}") %> · <%= t("topics.replies", count: topic.messages_count) %></p>
      <% if index.zero? %><span class="similar__read"><%= t("topics.read_first") %> <%= icon "arrow-up-right", size: 12 %></span><% end %>
    <% end %>
  <% end %>
<% end %>
