<%# "Draft with AI" / "Try another draft" controls for the create task and chain pages. %>
<% if Llm.enabled? %>
  <div class="ai-draft">
    <% if drafted %><span class="tag tag--draft"><%= icon "sparkles", size: 13 %>Drafted from <%= pluralize(topic.messages_count, "reply") %></span><% end %>
    <%= link_to url, class: "btn btn--small", data: { hotkey: "r" } do %><%= icon "rotate-ccw", size: 13 %><span><%= drafted ? "Try another draft" : "Draft with AI" %></span><%= render "shared/key", label: "R" %><% end %>
  </div>
<% end %>
