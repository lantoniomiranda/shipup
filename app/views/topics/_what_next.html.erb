<%# Sidebar actions for a topic: turn it into work, or talk it through live. %>
<% can_change = topic.author == Current.user || project.managed_by?(Current.user) %>
<section class="side__section" data-controller="menu">
  <h3 class="eyebrow"><%= t("topics.what_next") %></h3>

  <% if topic.canceled? %>
    <p class="capacity__note"><%= t("topics.canceled_note") %></p>
  <% else %>
    <div class="move-on">
      <button type="button" class="btn btn--primary btn--block" data-action="menu#toggle" aria-haspopup="true" aria-expanded="false" data-menu-target="button">
        <%= icon "corner-down-right" %><span><%= t("topics.move_on") %></span><span class="btn__divider"></span><%= icon "chevron-down", size: 14 %>
      </button>

      <div class="menu" data-menu-target="panel" hidden>
        <p class="eyebrow"><%= t("topics.move_on_as") %></p>
        <%= link_to new_project_topic_task_path(project, topic), class: "menu__item menu__item--primary", data: { **hotkey_data(:create_task) } do %>
          <span class="menu__glyph"><%= icon "square-check" %></span>
          <span class="menu__text"><strong><%= t("topics.create_task") %></strong><span><%= t("topics.create_task_hint") %></span></span>
          <%= key_hint(:create_task) %>
        <% end %>
        <%= link_to new_project_topic_chain_path(project, topic), class: "menu__item", data: { **hotkey_data(:create_chain) } do %>
          <span class="menu__glyph"><%= icon "link" %></span>
          <span class="menu__text"><strong><%= t("topics.create_chain") %></strong><span><%= t("topics.create_chain_hint") %></span></span>
          <%= key_hint(:create_chain) %>
        <% end %>
      </div>
    </div>

    <%= link_to new_project_topic_meeting_path(project, topic), class: "btn btn--block", data: { **hotkey_data(:meet) } do %>
      <%= icon "video" %><span><%= t("topics.meet") %></span><%= key_hint(:meet) %>
    <% end %>
  <% end %>

  <% if can_change %>
    <% if topic.canceled? %>
      <%= button_to reopen_project_topic_path(project, topic), method: :patch, class: "btn btn--block", form: { class: "inline-form block-form" } do %>
        <%= icon "rotate-ccw" %><span><%= t("topics.reopen") %></span>
      <% end %>
    <% else %>
      <div data-controller="dialog">
        <button type="button" class="btn btn--block" data-action="dialog#open"><%= icon "ban" %><span><%= t("topics.cancel") %></span></button>
        <dialog class="modal" data-dialog-target="dialog" data-action="click->dialog#backdrop">
          <%= form_with url: cancel_project_topic_path(project, topic), method: :patch, class: "modal__form" do %>
            <h2><%= t("topics.cancel") %></h2>
            <p><%= t("topics.confirm_cancel") %></p>
            <%= text_field_tag :reason, nil, class: "input", placeholder: t("topics.reason"), "aria-label": t("topics.reason_label"), data: { dialog_target: "focus" } %>
            <div class="modal__actions">
              <button type="button" class="btn" data-action="dialog#close"><span><%= t("topics.keep") %></span></button>
              <button type="submit" class="btn btn--primary"><%= icon "ban" %><span><%= t("topics.cancel") %></span></button>
            </div>
          <% end %>
        </dialog>
      </div>
    <% end %>
  <% end %>
</section>
