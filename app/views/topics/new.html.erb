<% project_header @project, active: :topics %>

<%# The similar-topics controller wraps the form (the input) and the sidebar (the results frame). %>
<div class="split" data-controller="similar-topics" data-similar-topics-url-value="<%= similar_project_topics_path(@project) %>">
  <%= form_with model: [ @project, @topic ], class: "panel panel--form", data: { controller: "editor", editor_link_sample_value: t("editor.link_sample") } do |form| %>
    <header class="panel__bar">
      <%= link_to project_topics_path(@project), class: "thread__back", data: { **hotkey_data(:back) } do %>
        <%= icon "arrow-left" %><span><%= t("topics.back") %></span><%= key_hint(:back) %>
      <% end %>
    </header>

    <div class="form">
      <header class="form__heading">
        <h1><%= t("topics.new") %></h1>
        <p><%= t("topics.posts_to", project: @project.name) %></p>
      </header>

      <% if @topic.errors.any? %>
        <p class="flash flash--alert"><%= @topic.errors.full_messages.to_sentence %></p>
      <% end %>

      <fieldset class="field">
        <legend class="eyebrow"><%= t("common.type") %></legend>
        <div class="choice">
          <% Topic::KINDS.each do |kind| %>
            <label class="choice__option"><%= form.radio_button :kind, kind, class: "choice__input" %><span><%= t("enums.topic_kind.#{kind}") %></span></label>
          <% end %>
        </div>
      </fieldset>

      <div class="field">
        <%= form.label :title, t("common.title"), class: "eyebrow" %>
        <%= form.text_field :title, class: "input input--title", required: true, autofocus: true, autocomplete: "off",
                                    data: { similar_topics_target: "input", action: "input->similar-topics#search" } %>
      </div>

      <div class="field field--grow">
        <%= form.label :body, t("topics.what"), class: "eyebrow" %>
        <div class="editor">
          <div class="editor__toolbar" role="toolbar" aria-label="<%= t("common.formatting") %>">
            <% [ [ "bold", "bold", "**" ], [ "italic", "italic", "_" ], [ "list", "list", "- " ], [ "link", "link", "link" ], [ "at-sign", "mention", "@" ] ].each do |glyph, label, token| %>
              <button type="button" aria-label="<%= t("common.#{label}") %>" data-action="editor#format" data-editor-token-param="<%= token %>" data-editor-kind-param="<%= label %>"><%= icon glyph, size: 15 %></button>
            <% end %>
          </div>
          <%= form.text_area :body, class: "editor__input", data: { editor_target: "input", similar_topics_target: "body", action: "input->similar-topics#search" } %>
        </div>
      </div>

      <% if @project.clients.active.any? %>
        <fieldset class="field">
          <legend class="eyebrow"><%= t("topics.requested_by") %></legend>
          <div class="choice">
            <label class="choice__option"><%= form.radio_button :client_id, "", checked: @topic.client_id.nil?, class: "choice__input" %><span><%= t("topics.internal_idea") %></span></label>
            <% @project.clients.active.order(:name).each do |client| %>
              <label class="choice__option"><%= form.radio_button :client_id, client.id, class: "choice__input" %><span><%= t("topics.client_named", name: client.name) %></span></label>
            <% end %>
          </div>
        </fieldset>
      <% end %>
    </div>

    <footer class="panel__footer">
      <%= link_to project_topics_path(@project), class: "btn" do %><span><%= t("common.cancel") %></span><%= key_hint(:back) %><% end %>
      <button type="submit" class="btn btn--primary" data-hotkey="<%= Keybindings.keys(:submit) %>">
        <%= icon "send" %><span><%= t("topics.post") %></span><%= key_hint(:submit) %>
      </button>
    </footer>
  <% end %>

  <aside class="side side--wide">
    <section class="side__section">
      <h3 class="eyebrow"><%= t("topics.similar") %></h3>
      <%= turbo_frame_tag "similar_topics", data: { similar_topics_target: "results" } %>
    </section>
  </aside>
</div>
