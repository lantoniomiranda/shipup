<% project_header @project, active: :topics %>

<div class="panel">
  <header class="panel__header">
    <div class="panel__title-row">
      <h1>Topics</h1>
      <%= link_to new_project_topic_path(@project), class: "btn btn--primary", data: { **hotkey_data(:new_topic) } do %>
        <%= icon "plus" %><span><%= t("topics.new") %></span><%= key_hint(:new_topic) %>
      <% end %>
    </div>

    <div class="panel__filter-row">
      <div class="chips">
        <% [ [ "issues", "circle-alert" ], [ "features", "sparkles" ], [ "canceled", "ban" ], [ "approved", "circle-check" ] ].each do |key, glyph| %>
          <%= link_to project_topics_path(@project, filter: (key unless @filter == key), sort: @sort.presence_in(%w[new])),
                      class: "chip #{"chip--active" if @filter == key}", aria: { pressed: @filter == key } do %>
            <%= icon glyph, size: 14 %><%= t("topics.filters.#{key}") %> <%= @counts[key] %>
          <% end %>
        <% end %>
      </div>

      <div class="sort">
        <%= link_to t("topics.top"), project_topics_path(@project, filter: @filter), class: "sort__option #{"sort__option--active" if @sort == "top"}" %>
        <%= link_to t("topics.newest"), project_topics_path(@project, filter: @filter, sort: "new"), class: "sort__option #{"sort__option--active" if @sort == "new"}" %>
      </div>
    </div>
  </header>

  <% if @topics.empty? %>
    <p class="empty"><%= t("topics.empty_html", link: link_to(t("topics.start_one"), new_project_topic_path(@project))) %></p>
  <% else %>
    <ul class="topic-list">
      <%= render partial: "topics/row", collection: @topics, as: :topic, locals: { votes: @votes } %>
    </ul>
  <% end %>
</div>
