<% project_header @project, active: :topics %>
<% score_class = @vote&.value == 1 ? "votes__score--up" : "" %>

<div class="split" data-controller="hotkey">
  <section class="panel panel--thread">
    <header class="thread__header">
      <div class="thread__back-row">
        <%= link_to project_topics_path(@project), class: "thread__back", data: { hotkey_target: "trigger", hotkey_key: "escape" } do %>
          <%= icon "arrow-left" %><span>Topics</span><%= render "shared/key", label: "Esc" %>
        <% end %>

        <div class="vote-bar">
          <%= button_to project_topic_vote_path(@project, @topic, value: 1), class: "vote-bar__up #{"vote-bar__up--active" if @vote&.value == 1}", aria: { label: "Upvote" } do %>
            <%= icon "arrow-big-up", size: 16 %><span class="votes__score <%= score_class %>"><%= format("%+d", @topic.votes_score) %></span>
          <% end %>
          <%= button_to project_topic_vote_path(@project, @topic, value: -1), class: "vote-bar__down", aria: { label: "Downvote" } do %>
            <%= icon "arrow-big-down", size: 16 %>
          <% end %>
        </div>
      </div>

      <div class="thread__tags">
        <%= render "topics/kind_tag", topic: @topic, tinted: true %>
        <% if @topic.client %><span class="tag tag--client">Requested by <%= @topic.client.name %></span><% end %>
        <span class="tag tag--status tag--status-<%= @topic.status %>"><%= @topic.status.capitalize %></span>
      </div>

      <h1><%= @topic.title %></h1>
      <p class="thread__meta">Opened by <%= @topic.author.short_name %> · <%= topic_age(@topic.created_at) %> · <%= pluralize(@topic.messages_count, "reply") %></p>
    </header>

    <div class="messages">
      <%= render "topics/message", author: @topic.author, body: @topic.body, posted_at: @topic.created_at %>
      <% @messages.each do |message| %>
        <%= render "topics/message", author: message.author, body: message.body, posted_at: message.created_at, dom_id: "message-#{message.id}" %>
      <% end %>
    </div>

    <%= form_with model: [ @project, @topic, TopicMessage.new ], url: project_topic_messages_path(@project, @topic), class: "composer", data: { controller: "composer" } do |form| %>
      <%= form.text_area :body, rows: 1, placeholder: "Reply to this topic…", class: "composer__input", required: true,
                         data: { composer_target: "input", action: "keydown->composer#submitOnEnter" } %>
      <%= render "shared/key", label: "R" %>
      <button type="submit" class="composer__send" aria-label="Send reply"><%= icon "send", size: 16 %></button>
    <% end %>
  </section>

  <aside class="side">
    <%= render "topics/what_next", project: @project, topic: @topic %>

    <section class="side__section">
      <h3 class="eyebrow">In this chat</h3>
      <ul class="participants">
        <% @participants.each do |user, role| %>
          <li><%= avatar(user, size: :md) %><span><%= user.short_name %></span><em><%= role %></em></li>
        <% end %>
      </ul>
    </section>
  </aside>
</div>
