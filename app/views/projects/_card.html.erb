<%# One project on the home grid. `current` highlights the project you are working in. %>
<% sprint = project.active_sprint %>
<% percent = sprint&.progress_percent.to_i %>
<% lit = Project.xp_segments_lit(percent) %>

<%= link_to project_topics_path(project), class: "project-card hue-#{project.color} #{"project-card--current" if current}", data: { hotkey: position.to_s } do %>
  <div class="project-card__banner">
    <span class="project-card__sun"></span>
    <span class="project-card__chip"><%= icon project.icon, size: 20 %></span>
  </div>

  <div class="project-card__body">
    <div class="project-card__title">
      <h2><%= project.name %></h2>
    </div>

    <p class="project-card__description"><%= project.description %></p>

    <div class="project-card__stats">
      <span><%= icon "messages-square", size: 14 %><%= t("home.open_topics", count: open_topics) %></span>
      <span><%= icon "circle-check-big", size: 14 %><%= t("home.tasks", count: tasks) %></span>
    </div>

    <% if sprint %>
      <div class="xp">
        <div class="xp__labels">
          <span><%= sprint.name.upcase %> · <%= t("home.days_left", count: sprint.days_left).upcase %></span>
          <strong><%= t("home.xp", percent: percent) %></strong>
        </div>
        <div class="xp__bar" role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100">
          <% Project::XP_SEGMENTS.times do |segment| %>
            <span class="xp__segment <%= "xp__segment--on" if segment < lit %> <%= "xp__segment--edge" if segment == lit - 1 %>"></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="project-card__footer">
      <div class="avatar-stack">
        <% project.members.first(4).each do |member| %><%= avatar(member, size: :sm) %><% end %>
      </div>
      <span><%= time_ago_label(project.last_activity_at) %></span>
    </div>
  </div>
<% end %>
