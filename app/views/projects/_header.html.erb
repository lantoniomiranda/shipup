<%# Project title bar: mark, name, sprint, tabs and members. `active` is the current tab key. %>
<% sprint = project.active_sprint %>
<header class="project-header hue-<%= project.color %>">
  <div class="project-header__title">
    <span class="project-mark"><%= icon project.icon, size: 18 %></span>
    <h2><%= project.name %></h2>
    <% if sprint %>
      <span class="sprint-badge">
        <span class="sprint-badge__name"><%= icon "timer", size: 13 %><%= sprint.name %></span>
        <span class="sprint-badge__left"><%= t("home.days_left", count: sprint.days_left) %></span>
      </span>
    <% end %>
  </div>

  <nav class="tabs" aria-label="<%= t("nav.projects") %>" data-controller="tab-sort" data-tab-sort-url-value="<%= project_tab_order_path %>" title="<%= t("nav.reorder_tabs") %>">
    <% ProjectTabs.for(Current.user).each do |tab| %>
      <% path = project_tab_path(project, tab[:key]) %>
      <% current = tab[:key].to_sym == active %>
      <% body = capture do %>
        <%= icon tab[:icon] %><span><%= t("nav.#{tab[:key]}") %></span><%= key_hint(tab[:key].to_sym) unless current %>
      <% end %>
      <% if path %>
        <%= link_to body, path, class: "tab #{"tab--active" if current}", aria: { current: ("page" if current) }, draggable: true,
                    data: hotkey_data(tab[:key].to_sym, tab_sort_target: "tab", tab_key: tab[:key], action: "dragstart->tab-sort#start dragover->tab-sort#over drop->tab-sort#drop dragend->tab-sort#finish") %>
      <% else %>
        <span class="tab tab--soon" title="<%= t("nav.coming_soon") %>"><%= body %></span>
      <% end %>
    <% end %>
  </nav>

  <% if project.managed_by?(Current.user) %>
    <%= button_to project_path(project), method: :patch, params: { project: { status: project.completed? ? "active" : "completed" } },
                  class: "btn btn--small", form: { class: "inline-form", data: { turbo_confirm: project.completed? ? nil : t("home.confirm_complete", name: project.name) } } do %>
      <%= icon project.completed? ? "rotate-ccw" : "check", size: 13 %><span><%= project.completed? ? t("home.reopen") : t("home.complete") %></span>
    <% end %>
  <% end %>

  <div class="project-header__members">
    <% project.members.first(4).each do |member| %><%= avatar(member, size: :md, class: "avatar--ringed") %><% end %>
    <% extra = project.members.size - 4 %>
    <% if extra.positive? %><span class="project-header__more">+<%= extra %></span><% end %>
  </div>
</header>
