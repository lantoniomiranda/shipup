<% breadcrumbs t("nav.projects") %>
<% sprints_in_flight = @projects.count { |project| project.active_sprint } %>

<header class="page-header">
  <div class="page-header__heading">
    <h1><%= Current.user.greeting %></h1>
    <p>
      <%= t("home.summary",
            projects: t("home.projects", count: @status_counts.values.sum),
            sprints: t("home.sprints", count: sprints_in_flight),
            waiting: t("home.waiting", count: @waiting_count)) %>
    </p>
  </div>

  <div class="page-header__actions">
    <div class="segmented" role="tablist">
      <% Project::STATUSES.each do |status| %>
        <%= link_to projects_path_for(status), class: "segmented__item #{"segmented__item--active" if status == @status}", role: "tab",
                    aria: { selected: status == @status } do %>
          <%= t("enums.project_status.#{status}") %> <%= @status_counts.fetch(status, 0) %>
        <% end %>
      <% end %>
    </div>

    <% if Current.user.superadmin? %>
      <%= link_to new_project_path, class: "btn btn--primary", data: { hotkey: "n" } do %>
        <%= icon "plus" %><span><%= t("home.new_project") %></span><%= render "shared/key", label: "N" %>
      <% end %>
    <% end %>
  </div>
</header>

<% if @projects.empty? && !Current.user.superadmin? && @status_counts.empty? %>
  <p class="empty"><%= t("home.empty_html", email: Current.user.email) %></p>
<% end %>

<div class="project-grid">
  <% @projects.each_with_index do |project, index| %>
    <%= render "projects/card", project: project, position: index + 1, current: index.zero?,
               open_topics: @open_topic_counts.fetch(project.id, 0), tasks: @task_counts.fetch(project.id, 0) %>
  <% end %>

  <% if Current.user.superadmin? %>
    <%= link_to new_project_path, class: "project-card project-card--new" do %>
      <span class="project-card__plus"><%= icon "plus", size: 20 %></span>
      <strong><%= t("home.start_project") %></strong>
      <span><%= t("home.start_hint") %></span>
    <% end %>
  <% end %>
</div>
