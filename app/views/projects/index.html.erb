<% breadcrumbs "Projects" %>
<% sprints_in_flight = @projects.count { |project| project.current_sprint } %>

<header class="page-header" data-controller="hotkey">
  <div class="page-header__heading">
    <h1><%= Current.user.greeting %></h1>
    <p>
      <%= pluralize(@status_counts.values.sum, "project") %>, <%= pluralize(sprints_in_flight, "sprint") %> in flight.
      <%= pluralize(@waiting_count, "topic") %> <%= @waiting_count == 1 ? "is" : "are" %> waiting for your reply.
    </p>
  </div>

  <div class="page-header__actions">
    <div class="segmented" role="tablist">
      <% Project::STATUSES.each do |status| %>
        <%= link_to projects_path_for(status), class: "segmented__item #{"segmented__item--active" if status == @status}", role: "tab",
                    aria: { selected: status == @status } do %>
          <%= status.capitalize %> <%= @status_counts.fetch(status, 0) %>
        <% end %>
      <% end %>
    </div>

    <% if Current.user.role_in(Current.workspace) == "admin" %>
      <%= link_to new_project_path, class: "btn btn--primary", data: { hotkey_target: "trigger", hotkey_key: "n" } do %>
        <%= icon "plus" %><span>New project</span><%= render "shared/key", label: "N" %>
      <% end %>
    <% end %>
  </div>
</header>

<div class="project-grid">
  <% @projects.each_with_index do |project, index| %>
    <%= render "projects/card", project: project, position: index + 1, current: index.zero?,
               open_topics: @open_topic_counts.fetch(project.id, 0), tasks: @task_counts.fetch(project.id, 0) %>
  <% end %>

  <% if Current.user.role_in(Current.workspace) == "admin" %>
    <%= link_to new_project_path, class: "project-card project-card--new" do %>
      <span class="project-card__plus"><%= icon "plus", size: 20 %></span>
      <strong>Start a new project</strong>
      <span>Admins only · invite managers afterwards</span>
    <% end %>
  <% end %>
</div>
