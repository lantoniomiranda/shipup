<%
  key = %w[400 403 404 406 422].include?(code.to_s) ? code : 500
  title = t("errors.#{key}.title")
  detail = t("errors.#{key}.detail")
%>
<% content_for :title, "#{code} · #{title}" %>

<%= render layout: "shared/split_screen", locals: { eyebrow: t("errors.eyebrow", code: code), title: title, detail: detail } do %>
  <% if Current.user %>
    <%= link_to root_path, class: "btn btn--primary btn--lg" do %><%= icon "arrow-left" %><span><%= t("errors.back_projects") %></span><% end %>
  <% else %>
    <%= link_to "/sign_in", class: "btn btn--primary btn--lg" do %><span><%= t("errors.go_sign_in") %></span><% end %>
  <% end %>
  <button type="button" class="btn btn--lg" onclick="history.back()"><%= icon "corner-down-right" %><span><%= t("common.go_back") %></span></button>
<% end %>
