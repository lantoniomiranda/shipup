<%# One row of the setup rail. state: :done | :current | :todo %>
<li class="step step--<%= state %>">
  <div class="step__rail">
    <span class="step__node">
      <% if state == :done %><%= icon "check", size: 14 %><% else %><%= number %><% end %>
    </span>
    <% unless local_assigns[:last] %><span class="step__line"></span><% end %>
  </div>
  <div class="step__text">
    <strong><%= label %></strong>
    <span><%= caption %></span>
  </div>
</li>
