<% breadcrumbs [ "Workspace", root_path ], "Connectors" %>
<% content_for :title, "Connectors" %>
<%
  groups = {
    "Meetings" => [
      { key: "zoom", name: "Zoom", letter: "Z", hue: "blue", description: "Meeting links, cloud recording and transcripts by topic.", meeting: true },
      { key: "google_meet", name: "Google Meet", letter: "G", hue: "teal", description: "Meeting links through Google Calendar.", meeting: true },
      { key: "microsoft_teams", name: "Microsoft Teams", letter: "T", hue: "plum", description: "Meeting links through Microsoft 365 calendars.", coming_soon: true }
    ],
    "Code" => [
      { key: "github", name: "GitHub", letter: "GH", hue: "blue", description: "Link repositories so pull requests show up on the tasks they mention.", repositories: true }
    ]
  }
  default_tool = @workspace.meeting_provider
%>

<header class="page-header">
  <div class="page-header__heading">
    <h1>Connectors</h1>
    <p>Connect the tools your team already uses. Everyone in <strong><%= @workspace.name %></strong> shares these connections.</p>
  </div>
  <div class="page-header__actions"><span class="tag tag--admin">Admin only</span></div>
</header>

<div class="connectors">
  <% groups.each do |group, tools| %>
    <section class="connectors__group">
      <h2 class="eyebrow"><%= group %></h2>
      <div class="connectors__grid">
        <% tools.each do |tool| %>
          <%= render "integrations/tool", tool: tool, connection: @connections[tool[:key]], default: default_tool == tool[:key] %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="connectors__group">
    <h2 class="eyebrow">AI</h2>
    <div class="connectors__grid">
      <div class="connector">
        <div class="connector__head">
          <span class="connector__logo connector__logo--mustard"><%= icon "sparkles", size: 20 %></span>
          <div class="connector__title">
            <strong>AI drafting</strong>
            <% if Llm.enabled? %>
              <span class="connector__status connector__status--on">Enabled · <%= Llm.provider %></span>
            <% else %>
              <span class="connector__status">Not configured</span>
            <% end %>
          </div>
        </div>
        <p class="connector__text">Drafts tasks and chains from a topic. Set by the server operator: <code>LLM_ENABLED</code> (claude, gemini, grok or gpt) and <code>LLM_API_KEY</code>.</p>
      </div>
    </div>
  </section>
</div>
