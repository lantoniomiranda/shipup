<% breadcrumbs [ t("settings.title"), account_path ], t("settings.connectors.title") %>
<% content_for :title, t("integrations.title") %>
<%
  groups = {
    t("integrations.group_meetings") => [
      { key: "zoom", name: "Zoom", letter: "Z", hue: "blue", description: t("integrations.zoom"), meeting: true },
      { key: "google_meet", name: "Google Meet", letter: "G", hue: "teal", description: t("integrations.meet"), meeting: true },
      { key: "microsoft_teams", name: "Microsoft Teams", letter: "T", hue: "plum", description: t("integrations.teams"), coming_soon: true }
    ],
    t("integrations.code") => [
      { key: "github", name: "GitHub", letter: "GH", hue: "blue", description: t("integrations.github"), repositories: true }
    ]
  }
  default_tool = @default_tool
%>

<section class="panel">
<div class="form form--scroll">
<header class="page-header">
  <div class="page-header__heading">
    <h1><%= t("integrations.title") %></h1>
    <p><%= t("integrations.connectors_intro") %></p>
  </div>
  <div class="page-header__actions"><span class="tag tag--admin"><%= t("integrations.admin_only") %></span></div>
</header>

<div class="connectors">
  <% groups.each do |group, tools| %>
    <section class="connectors__group">
      <h2 class="eyebrow"><%= group %></h2>
      <div class="connectors__grid">
        <% tools.each do |tool| %>
          <%= render "integrations/tool", tool: tool, connection: @connections[tool[:key]], default: default_tool == tool[:key] %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="connectors__group">
    <h2 class="eyebrow"><%= t("integrations.group_ai") %></h2>
    <div class="connectors__grid">
      <div class="connector">
        <div class="connector__head">
          <span class="connector__logo connector__logo--mustard"><%= icon "sparkles", size: 20 %></span>
          <div class="connector__title">
            <strong><%= t("integrations.ai_drafting") %></strong>
            <% if Llm.enabled? %>
              <span class="connector__status connector__status--on"><%= t("integrations.ai_enabled", provider: Llm.provider) %></span>
            <% else %>
              <span class="connector__status"><%= t("integrations.ai_not_configured") %></span>
            <% end %>
          </div>
        </div>
        <p class="connector__text"><%= t("integrations.ai_text_html") %></p>
      </div>
    </div>
  </section>
</div>
</div>
</section>
