<% content_for :title, "Meeting tool" %>
<%
  tools = [
    { key: "zoom", name: "Zoom", letter: "Z", hue: "blue", description: "Links, cloud recording and transcripts by topic." },
    { key: "microsoft_teams", name: "Microsoft Teams", letter: "T", hue: "plum", description: "Links through Microsoft 365 calendars.", coming_soon: true },
    { key: "google_meet", name: "Google Meet", letter: "G", hue: "teal", description: "Links through Google Calendar." }
  ]
  selected = @workspace.meeting_provider
%>

<main class="setup">
  <aside class="setup__steps">
    <%= render "shared/logo", size: :small %>

    <header class="setup__intro">
      <h1>Set up your workspace</h1>
      <span class="tag tag--admin">Admin only</span>
    </header>

    <ol class="steps">
      <%= render "integrations/step", state: :done, label: "Workspace", caption: @workspace.name %>
      <%= render "integrations/step", state: :current, number: 2, label: "Meeting tool", caption: "Pick once for everyone" %>
      <%= render "integrations/step", state: :todo, number: 3, label: "Calendar", caption: "Working hours and availability" %>
      <%= render "integrations/step", state: :todo, number: 4, label: "People", caption: "Invite admins and managers", last: true %>
    </ol>
  </aside>

  <section class="setup__panel">
    <header class="setup__header">
      <p class="eyebrow">Step 2 of 4</p>
      <h2>Choose your meeting tool</h2>
      <p class="setup__subtitle">Everyone uses it for meeting links. You can change it later in Integrations.</p>
    </header>

    <% flash.each do |type, message| %>
      <p class="flash flash--<%= type %>" role="status"><%= message %></p>
    <% end %>

    <div class="setup__body">
      <% tools.each do |tool| %>
        <%= render "integrations/tool", tool: tool, connection: @connections[tool[:key]], selected: selected == tool[:key] %>
      <% end %>

      <h3 class="eyebrow setup__section">Code</h3>
      <%= render "integrations/tool", tool: { key: "github", name: "GitHub", letter: "GH", hue: "blue", description: "Link repositories so pull requests show up on tasks." },
                                      connection: @connections["github"], selected: false, selectable: false %>
      <% if @connections["github"] %>
        <p class="setup__hint"><%= link_to "Choose repositories for your projects", github_repositories_path, class: "link" %></p>
      <% end %>
    </div>

    <footer class="setup__footer">
      <%= link_to root_path, class: "btn", data: { **hotkey_data(:back) } do %>
        <%= icon "arrow-left" %><span>Back</span><%= key_hint(:back) %>
      <% end %>

      <%= form_with url: meeting_tool_path, method: :patch, id: "meeting-tool-form" do %>
        <button type="submit" class="btn btn--primary" data-hotkey="<%= Keybindings.keys(:submit) %>">
          <%= icon "arrow-right" %><span>Continue</span><%= key_hint(:submit) %>
        </button>
      <% end %>
    </footer>
  </section>
</main>
