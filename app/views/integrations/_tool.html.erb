<%# One connector card. `default` marks the workspace's meeting tool. %>
<% connected = connection.present? %>
<div class="connector <%= "connector--default" if default %> <%= "connector--muted" if tool[:coming_soon] %>">
  <div class="connector__head">
    <span class="connector__logo connector__logo--<%= tool[:hue] %>"><%= tool[:letter] %></span>
    <div class="connector__title">
      <strong><%= tool[:name] %></strong>
      <% if tool[:coming_soon] %>
        <span class="connector__status"><%= t("integrations.coming_soon") %></span>
      <% elsif connected %>
        <span class="connector__status connector__status--on" title="<%= connection.external_account %>"><%= t("integrations.connected_as", account: connection.external_account) %></span>
      <% else %>
        <span class="connector__status"><%= t("integrations.not_connected") %></span>
      <% end %>
    </div>
    <% if default %><span class="tag connector__badge"><%= t("integrations.default") %></span><% end %>
  </div>

  <p class="connector__text"><%= tool[:description] %></p>

  <% unless tool[:coming_soon] %>
    <div class="connector__actions">
      <% if connected %>
        <% if tool[:meeting] && !default %>
          <%= button_to meeting_tool_path(provider: tool[:key]), method: :patch, class: "btn btn--primary", form: { class: "inline-form" } do %><%= icon "check" %><span><%= t("integrations.use_for_meetings") %></span><% end %>
        <% end %>
        <% if tool[:repositories] %>
          <%= link_to github_repositories_path, class: "btn" do %><%= icon "git-branch" %><span><%= t("integrations.repositories") %></span><% end %>
        <% end %>
        <%= button_to connect_integration_path(provider: tool[:key]), method: :delete, class: "btn", form: { class: "inline-form", data: { turbo_confirm: t("integrations.disconnect_confirm", name: tool[:name]) } } do %><span><%= t("integrations.disconnect") %></span><% end %>
      <% else %>
        <%= button_to connect_integration_path(provider: tool[:key]), class: "btn btn--primary", data: { turbo: false }, form: { class: "inline-form" } do %><%= icon "plug" %><span><%= t("integrations.connect") %></span><% end %>
      <% end %>
    </div>
  <% end %>
</div>
