<% breadcrumbs [ t("settings.title"), account_path ], t("settings.appearance.title") %>
<% content_for :title, t("settings.appearance.title") %>
<% themes = { "paper" => [ "#FBF7EC", "#E9DDC4", "#2B211A" ], "mist" => [ "#F2F6FA", "#C9D6E2", "#16202A" ], "sage" => [ "#F3F6EC", "#D6DEC8", "#1C2519" ],
              "night" => [ "#1F2030", "#101118", "#E4E6F4" ], "system" => [ "#FBF7EC", "#1F2030", "#2B211A" ] } %>
<% accents = { "orange" => "#E8632B", "blue" => "#6F94D6", "teal" => "#4FA396", "plum" => "#C8628A", "mustard" => "#EBB43B" } %>
<% custom_value = @preference.custom_accent || "#E8632B" %>

<%= form_with model: @preference, url: appearance_path, method: :patch, scope: :preference, class: "split appearance",
              data: { controller: "theme-picker", theme_picker_density_value: Appearance::DENSITY_SCALE.to_json, theme_picker_text_value: Appearance::TEXT_SCALE.to_json,
                      theme_picker_fonts_value: Appearance::FONTS.transform_values { |font| font[:google] }.to_json } do |form| %>
  <section class="panel panel--form panel--narrow">
    <div class="form form--scroll">
      <header class="form__heading"><h1><%= t("appearance.title") %></h1><p><%= t("appearance.intro") %></p></header>

      <fieldset class="field">
        <legend class="eyebrow"><%= t("appearance.background") %></legend>
        <div class="theme-grid theme-grid--five">
          <% themes.each do |name, (surface, sunken, ink)| %>
            <label class="theme-option">
              <%= form.radio_button :theme_bg, name, class: "theme-option__input", data: { action: "theme-picker#apply", attr: "data-bg" } %>
              <span class="theme-option__swatch" style="--s: <%= surface %>; --d: <%= sunken %>; --i: <%= ink %>"><i></i><b></b></span>
              <span class="theme-option__name"><%= t("enums.theme.#{name}") %><%= icon "check", size: 14 %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="field">
        <legend class="eyebrow"><%= t("appearance.accent") %></legend>
        <div class="accent-row accent-row--six">
          <% accents.each do |name, color| %>
            <label class="accent-option">
              <%= form.radio_button :theme_accent, name, class: "accent-option__input", data: { action: "theme-picker#accent", attr: "data-accent" } %>
              <span class="accent-option__chip" style="background: <%= color %>"><%= icon "check", size: 18 %></span>
              <span class="accent-option__name"><%= t("enums.accent.#{name}") %></span>
            </label>
          <% end %>
          <label class="accent-option accent-option--custom">
            <%= form.radio_button :theme_accent, "custom", class: "accent-option__input", data: { action: "theme-picker#accent", attr: "data-accent", theme_picker_target: "customRadio" } %>
            <span class="accent-option__chip" data-theme-picker-target="customChip" style="background: <%= custom_value %>"><%= icon "check", size: 18 %></span>
            <span class="accent-option__name"><%= t("appearance.custom") %></span>
            <%= form.color_field :custom_accent, value: custom_value, class: "accent-option__picker", "aria-label": t("appearance.custom_label"), data: { action: "input->theme-picker#custom", theme_picker_target: "customColor" } %>
          </label>
        </div>
      </fieldset>

      <fieldset class="field">
        <legend class="eyebrow"><%= t("appearance.font") %></legend>
        <div class="font-grid">
          <% Appearance::FONTS.each do |key, font| %>
            <label class="font-option">
              <%= form.radio_button :font, key, class: "font-option__input", data: { action: "theme-picker#font", attr: "data-font" } %>
              <span class="font-option__sample" style="font-family: <%= font[:stack] %>">Aa</span>
              <span class="font-option__name"><%= font[:label] %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="field-row field-row--wrap">
        <fieldset class="field">
          <legend class="eyebrow"><%= t("appearance.density") %></legend>
          <div class="choice">
            <% UserPreference::DENSITIES.each do |value| %>
              <label class="choice__option"><%= form.radio_button :density, value, class: "choice__input", data: { action: "theme-picker#zoom", theme_picker_target: "density" } %><span><%= t("enums.density.#{value}") %></span></label>
            <% end %>
          </div>
        </fieldset>
        <fieldset class="field">
          <legend class="eyebrow"><%= t("appearance.text_size") %></legend>
          <div class="choice">
            <% UserPreference::TEXT_SIZES.each do |value| %>
              <label class="choice__option"><%= form.radio_button :text_size, value, class: "choice__input", data: { action: "theme-picker#zoom", theme_picker_target: "text" } %><span><%= t("enums.text_size.#{value}") %></span></label>
            <% end %>
          </div>
        </fieldset>
        <fieldset class="field">
          <legend class="eyebrow"><%= t("appearance.corners") %></legend>
          <div class="choice">
            <% UserPreference::CORNERS.each do |value| %>
              <label class="choice__option"><%= form.radio_button :corners, value, class: "choice__input", data: { action: "theme-picker#apply", attr: "data-corners" } %><span><%= t("enums.corners.#{value}") %></span></label>
            <% end %>
          </div>
        </fieldset>
      </div>

      <fieldset class="field">
        <legend class="eyebrow"><%= t("appearance.effects") %></legend>
        <ul class="effects">
          <% [ [ :hard_shadows, t("appearance.shadows_title"), t("appearance.shadows_hint"), "data-shadows", "hard", "flat" ],
               [ :high_contrast, t("appearance.contrast_title"), t("appearance.contrast_hint"), "data-contrast", "high", "normal" ],
               [ :reduce_motion, t("appearance.motion_title"), t("appearance.motion_hint"), "data-motion", "reduced", "normal" ] ].each do |field, title, hint, attr, on, off| %>
            <li>
              <div><strong><%= title %></strong><small><%= hint %></small></div>
              <%= form.hidden_field field, value: "0", id: nil %>
              <%= form.check_box field, { class: "switch", data: { action: "theme-picker#apply", attr: attr, on: on, off: off } }, "1", "0" %>
            </li>
          <% end %>
        </ul>
      </fieldset>

      <fieldset class="field">
        <legend class="eyebrow"><%= t("appearance.menu") %></legend>
        <p class="effects__hint"><%= t("appearance.menu_hint") %></p>
        <button type="submit" form="reset-tab-order" class="btn btn--small" formnovalidate><%= icon "rotate-ccw", size: 13 %><span><%= t("appearance.menu_reset") %></span></button>
      </fieldset>
    </div>

    <footer class="panel__footer">
      <button type="submit" name="reset" value="1" class="btn" formnovalidate data-hotkey="<%= Keybindings.keys(:reset_appearance) %>"><%= icon "rotate-ccw" %><span><%= t("appearance.reset") %></span><%= key_hint(:reset_appearance) %></button>
      <button type="submit" class="btn btn--primary" data-hotkey="<%= Keybindings.keys(:submit) %>"><%= icon "check" %><span><%= t("common.done") %></span><%= key_hint(:submit) %></button>
    </footer>
  </section>

  <section class="panel panel--preview">
    <header class="panel__bar panel__bar--split"><span class="eyebrow"><%= t("appearance.preview") %></span></header>
    <div class="preview">
      <h3 class="eyebrow"><%= t("appearance.buttons") %></h3>
      <div class="preview__row">
        <span class="btn btn--primary"><%= icon "plus" %><span><%= t("appearance.new_topic") %></span></span>
        <span class="btn"><%= icon "video" %><span><%= t("appearance.create_meeting") %></span></span>
      </div>
      <div class="preview__row">
        <span class="tag tag--task-status"><%= t("appearance.sample_progress") %></span><span class="tag tag--client"><%= t("appearance.sample_decision") %></span><span class="tag tag--issue"><%= t("appearance.sample_bug") %></span><span class="tag tag--task"><%= t("appearance.sample_deployed") %></span><span class="tag tag--similar"><%= t("appearance.sample_familiar") %></span>
      </div>
      <h3 class="eyebrow"><%= t("appearance.lists") %></h3>
      <ul class="preview__list">
        <li class="preview__list-item--active"><strong><%= t("appearance.sample_one_title") %></strong><small><%= t("appearance.sample_one_meta") %></small></li>
        <li><strong><%= t("appearance.sample_two_title") %></strong><small><%= t("appearance.sample_two_meta") %></small></li>
      </ul>
      <h3 class="eyebrow"><%= t("appearance.board_card") %></h3>
      <div class="preview-board">
        <article class="card card--running"><div class="card__top"><span class="card__key">APO-97</span><span class="card__topic"><%= icon "message-square", size: 12 %>from D-12</span></div>
          <span class="card__title">Per-key rate limiting</span>
          <div class="card__timer"><span class="card__timer-dot"></span><span>02:14:09</span></div>
          <div class="card__footer"><span class="tag tag--label hue-orange">Backend</span><span class="card__meta">Oct 19 <%= avatar(Current.user, size: :sm) %></span></div></article>
        <div class="xp"><div class="xp__labels"><span>SPRINT 14 · 3 DAYS LEFT</span><strong>68% XP</strong></div>
          <div class="xp__bar hue-orange"><% 20.times do |i| %><span class="xp__segment <%= "xp__segment--on" if i < 14 %> <%= "xp__segment--edge" if i == 13 %>"></span><% end %></div></div>
      </div>
    </div>
  </section>
<% end %>

<%= form_with url: project_tab_order_path, method: :delete, id: "reset-tab-order", class: "hidden-form" do %><% end %>
