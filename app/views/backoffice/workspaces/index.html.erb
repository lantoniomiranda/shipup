<% content_for :title, "Tenants" %>
<header class="page-header">
  <div class="page-header__heading"><h1>Tenants</h1><p><%= pluralize(@workspaces.size, "workspace") %><%= " matching “#{params[:q]}”" if params[:q].present? %>.</p></div>
  <div class="page-header__actions">
    <%= form_with url: backoffice_tenants_path, method: :get, class: "bo-search" do %>
      <%= hidden_field_tag :status, @status if @status %>
      <%= search_field_tag :q, params[:q], placeholder: "Search name or slug", class: "input input--small-search", "aria-label": "Search tenants" %>
    <% end %>
    <%= link_to new_backoffice_tenant_path, class: "btn btn--primary" do %><%= icon "plus" %><span>New tenant</span><% end %>
  </div>
</header>

<div class="toolbar toolbar--chips">
  <div class="segmented segmented--dark">
    <%= link_to "All", backoffice_tenants_path(q: params[:q]), class: "segmented__item #{"segmented__item--active" if @status.nil?}" %>
    <% Workspace::STATUSES.each do |status| %>
      <%= link_to status.capitalize, backoffice_tenants_path(q: params[:q], status: status), class: "segmented__item #{"segmented__item--active" if @status == status}" %>
    <% end %>
  </div>
</div>

<section class="panel panel--table">
  <% if @workspaces.empty? %>
    <p class="empty">No tenants match.</p>
  <% else %>
    <table class="table">
      <thead><tr><th>Tenant</th><th>Plan</th><th>Status</th><th>Members</th><th>Projects</th><th>Last sign-in</th><th>Created</th></tr></thead>
      <tbody>
        <% @workspaces.each do |workspace| %>
          <tr>
            <td><%= link_to backoffice_tenant_path(workspace), class: "table__title" do %><%= workspace.name %><% end %><small><%= workspace.slug %></small></td>
            <td><span class="tag tag--plan-<%= workspace.plan %>"><%= workspace.plan.capitalize %></span></td>
            <td><span class="tag <%= workspace.suspended? ? "tag--request-declined" : "tag--client-active" %>"><%= workspace.status.capitalize %></span></td>
            <td><%= @member_counts.fetch(workspace.id, 0) %><%= " / #{workspace.seats_limit}" if workspace.seats_limit %></td>
            <td><%= @project_counts.fetch(workspace.id, 0) %></td>
            <td><%= (seen = @last_seen[workspace.id]) ? "#{time_ago_in_words(seen)} ago" : "Never" %></td>
            <td><%= workspace.created_at.strftime("%b %-d, %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
