<% content_for :title, "Backoffice" %>
<header class="page-header">
  <div class="page-header__heading"><h1>Tenants overview</h1><p>Every customer workspace on the platform.</p></div>
  <div class="page-header__actions"><%= link_to new_backoffice_tenant_path, class: "btn btn--primary" do %><%= icon "plus" %><span>New tenant</span><% end %></div>
</header>

<div class="kpis">
  <section class="kpi"><h3 class="eyebrow">Tenants</h3><strong><%= @status_counts.values.sum %></strong><p><%= @status_counts.fetch("active", 0) %> active · <%= @status_counts.fetch("suspended", 0) %> suspended</p></section>
  <section class="kpi"><h3 class="eyebrow">People</h3><strong><%= @users_count %></strong><p><%= pluralize(@pending_invitations, "invitation") %> pending</p></section>
  <section class="kpi"><h3 class="eyebrow">Projects</h3><strong><%= @projects_count %></strong><p><%= number_with_delimiter(@tasks_count) %> tasks</p></section>
  <section class="kpi"><h3 class="eyebrow">Plans</h3><strong><%= @plan_counts.fetch("trial", 0) %></strong><p>on trial · <%= (@plan_counts.values.sum - @plan_counts.fetch("trial", 0)) %> paying</p></section>
</div>

<div class="bo-columns">
  <section class="chart-card">
    <header><h3 class="eyebrow">Newest tenants</h3><%= link_to "All tenants", backoffice_tenants_path, class: "link" %></header>
    <ul class="closed bo-list">
      <% @recent.each do |workspace| %>
        <li><%= link_to workspace.name, backoffice_tenant_path(workspace) %><span class="tag tag--plan-<%= workspace.plan %>"><%= workspace.plan.capitalize %></span><span><%= workspace.memberships.count %> members</span><time><%= workspace.created_at.strftime("%b %-d") %></time></li>
      <% end %>
      <% if @recent.empty? %><li class="entries__empty">No tenants yet.</li><% end %>
    </ul>
  </section>

  <section class="chart-card">
    <header><h3 class="eyebrow">Trials ending within a week</h3></header>
    <ul class="closed bo-list">
      <% @ending_trials.each do |workspace| %>
        <li><%= link_to workspace.name, backoffice_tenant_path(workspace) %><span class="tag tag--request-pending">Trial</span><span></span><time><%= workspace.trial_ends_at.strftime("%b %-d") %></time></li>
      <% end %>
      <% if @ending_trials.empty? %><li class="entries__empty">Nothing expiring soon.</li><% end %>
    </ul>
  </section>
</div>
