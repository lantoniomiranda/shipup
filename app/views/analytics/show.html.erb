<% project_header @project, active: :analytics %>
<% a = @analytics %>
<% duration = ->(minutes) { minutes >= 60 ? "#{minutes / 60}h #{format("%02d", minutes % 60)}m".sub(" 00m", "") : "#{minutes}m" } %>

<div class="analytics">
  <header class="toolbar">
    <h1><%= t("analytics.title") %></h1>
    <div class="segmented segmented--dark">
      <% Analytics::RANGES.each do |key| %>
        <%= link_to t("enums.analytics_range.#{key}"), project_analytics_path(@project, range: key), class: "segmented__item #{"segmented__item--active" if a.range_key == key}" %>
      <% end %>
    </div>
  </header>

  <div class="kpis">
    <section class="kpi"><h3 class="eyebrow"><%= t("analytics.topics") %></h3><strong><%= a.topics_count %></strong><p><%= t("analytics.vs_previous", delta: format("%+d", a.topics_delta)) %></p></section>
    <section class="kpi"><h3 class="eyebrow"><%= t("analytics.hours") %></h3><strong><%= a.hours_logged %>h</strong><p><%= t("analytics.across", count: a.deployed_items) %></p></section>
    <section class="kpi"><h3 class="eyebrow"><%= t("analytics.meetings") %></h3><strong><%= a.meetings.size %></strong><p><%= t("analytics.decisions", duration: duration.(a.meeting_minutes), decided: a.decided_meetings, total: a.meetings.size) %></p></section>
    <section class="kpi"><h3 class="eyebrow"><%= t("analytics.invited") %></h3><strong><%= a.average_invited %></strong><p><%= t("analytics.per_meeting") %></p></section>
  </div>

  <div class="charts">
    <section class="chart-card">
      <header><h3 class="eyebrow"><%= t("analytics.topics_week") %></h3>
        <ul class="legend"><li><i class="legend__swatch legend__swatch--progress"></i><%= t("enums.chart.opened") %></li><li><i class="legend__swatch legend__swatch--vacation"></i><%= t("enums.chart.approved") %></li><li><i class="legend__swatch legend__swatch--canceled"></i><%= t("enums.chart.canceled") %></li></ul></header>
      <div class="chart chart--grouped">
        <% a.weeks.each do |week| %>
          <div class="chart__col">
            <div class="chart__bars">
              <% { "opened" => week.opened, "approved" => week.approved, "canceled" => week.canceled }.each do |kind, value| %>
                <span class="chart__bar chart__bar--<%= kind %>" style="height: <%= value * 100.0 / a.max_topics %>%" title="<%= value %> <%= kind %>"></span>
              <% end %>
            </div>
            <small><%= week.label %></small>
          </div>
        <% end %>
      </div>
    </section>

    <section class="chart-card">
      <header><h3 class="eyebrow"><%= t("analytics.hours_week") %></h3><ul class="legend"><li><i class="legend__swatch legend__swatch--vacation"></i><%= t("enums.chart.work") %></li></ul></header>
      <div class="chart">
        <% a.weeks.each do |week| %>
          <div class="chart__col">
            <div class="chart__bars"><span class="chart__bar chart__bar--work" style="height: <%= week.hours * 100.0 / a.max_hours %>%" title="<%= week.hours %>h"></span></div>
            <small><%= week.label %></small>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <section class="chart-card chart-card--table">
    <header><h3 class="eyebrow"><%= t("analytics.closed") %></h3><strong><%= t("analytics.topics_count", count: a.closed_topics.size) %></strong></header>
    <% if a.closed_topics.empty? %>
      <p class="empty"><%= t("analytics.nothing_closed") %></p>
    <% else %>
      <ul class="closed">
        <% a.closed_topics.each do |topic| %>
          <li>
            <%= link_to topic.title, project_topic_path(@project, topic) %>
            <span class="tag <%= topic.approved? ? "tag--task" : "tag--quiet" %>"><%= t("analytics.closed_as", status: t("enums.topic_status.#{topic.status}").downcase) %></span>
            <span><%= t("topics.replies", count: topic.messages_count) %></span>
            <time><%= short_date(topic.created_at) %></time>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
