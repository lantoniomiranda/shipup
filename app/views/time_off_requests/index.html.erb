<% breadcrumbs [ t("nav.projects"), root_path ], t("time_off.crumb") %>
<% content_for :content_class, "shell__content--bare" %>
<% days = (@month.beginning_of_month..@month.end_of_month).to_a %>
<% previous_month = (@month - 1.month).strftime("%Y-%m") %>
<% next_month = (@month + 1.month).strftime("%Y-%m") %>

<div class="time-off">
  <aside class="time-off__side">
    <section class="panel-card panel-card--accent">
      <header class="time-off__title">
        <h1><%= t("time_off.title") %></h1>
        <%= link_to new_time_off_request_path, class: "btn btn--primary", data: { **hotkey_data(:request_time_off) } do %><%= icon "plus" %><span><%= t("time_off.request") %></span><%= key_hint(:request_time_off) %><% end %>
      </header>

      <% TimeOffRequest::KINDS.each do |kind| %>
        <% balance = @balances.fetch(kind) %>
        <div class="allowance">
          <div class="allowance__labels"><strong><%= t("enums.time_off_kind.#{kind}") %></strong><span><%= t("time_off.days_of", left: balance.left, allowance: balance.allowance) %></span></div>
          <div class="xp__bar allowance__bar allowance__bar--<%= kind %>">
            <% balance.allowance.times do |index| %><span class="xp__segment <%= "xp__segment--on" if index < balance.used %>"></span><% end %>
          </div>
        </div>
      <% end %>
    </section>

    <section class="panel-card">
      <h3 class="eyebrow"><%= t("time_off.my_requests") %></h3>
      <ul class="requests">
        <% @mine.each do |request| %>
          <li>
            <div><strong><%= short_date(request.starts_on) %><%= " – #{request.starts_on.month == request.ends_on.month ? request.ends_on.day : short_date(request.ends_on)}" unless request.starts_on == request.ends_on %></strong>
              <small><%= t("enums.time_off_kind_short.#{request.kind}") %> · <%= t("time_off.working_days", count: request.working_days) %></small></div>
            <span class="tag tag--request-<%= request.status %>"><%= request.pending? ? (request.approver ? t("time_off.waiting_for", name: request.approver.short_name) : t("time_off.waiting_approval")) : t("enums.time_off_status.#{request.status}") %></span>
          </li>
        <% end %>
        <% if @mine.empty? %><li class="entries__empty"><%= t("time_off.nothing") %></li><% end %>
      </ul>
    </section>

    <% if @to_approve.any? %>
      <section class="panel-card">
        <header class="time-off__approve-head"><h3 class="eyebrow"><%= t("time_off.to_approve") %></h3><span class="tag tag--request-pending"><%= t("time_off.waiting_count", count: @to_approve.size) %></span></header>
        <% @to_approve.each do |request| %>
          <% overlaps = TimeOffRequest.where(user: @people).where.not(id: request.id).where.not(status: "declined").overlapping(request.starts_on..request.ends_on).includes(:user).first %>
          <div class="approval">
            <div class="approval__who"><%= avatar(request.user, size: :md) %><div><strong><%= request.user.short_name %></strong><small><%= short_date(request.starts_on) %> – <%= request.ends_on.day %> · <%= t("enums.time_off_kind_short.#{request.kind}") %> · <%= t("time_off.working_days", count: request.working_days) %></small></div></div>
            <% if overlaps %><span class="tag tag--request-pending"><%= t("time_off.overlaps", name: overlaps.user.short_name, date: short_date(overlaps.starts_on)) %></span><% end %>
            <div class="approval__actions">
              <%= button_to time_off_request_path(request, decision: "decline"), method: :patch, class: "btn" do %><%= icon "x" %><span><%= t("time_off.decline") %></span><% end %>
              <%= button_to time_off_request_path(request, decision: "approve"), method: :patch, class: "btn btn--primary" do %><%= icon "check" %><span><%= t("time_off.approve") %></span><% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>
  </aside>

  <section class="timeline">
    <header class="timeline__head">
      <h2><%= month_heading(@month) %></h2>
      <%= link_to icon("chevron-left"), time_off_requests_path(month: previous_month), class: "pager__button", aria: { label: t("time_off.previous_month") } %>
      <%= link_to icon("chevron-right"), time_off_requests_path(month: next_month), class: "pager__button", aria: { label: t("time_off.next_month") } %>
      <ul class="legend">
        <li><i class="legend__swatch legend__swatch--vacation"></i><%= t("time_off.legend_vacation") %></li>
        <li><i class="legend__swatch legend__swatch--sick"></i><%= t("time_off.legend_sick") %></li>
        <li><i class="legend__swatch legend__swatch--waiting"></i><%= t("time_off.legend_waiting") %></li>
      </ul>
    </header>

    <div class="timeline__grid" style="--days: <%= days.size %>">
      <div class="timeline__row timeline__row--head">
        <span></span>
        <div class="timeline__days">
          <% days.each do |day| %><span class="<%= "weekend" if day.on_weekend? %> <%= "today" if day == Date.current %>"><small><%= narrow_weekday(day) %></small><%= day.day %></span><% end %>
        </div>
      </div>
      <% @people.each do |person| %>
        <div class="timeline__row">
          <span class="timeline__person"><%= avatar(person, size: :sm) %><%= person.short_name %></span>
          <div class="timeline__days timeline__days--track">
            <% days.each do |day| %><i class="<%= "weekend" if day.on_weekend? %>"></i><% end %>
            <% Array(@requests[person.id]).each do |request| %>
              <% first = [ request.starts_on, days.first ].max %>
              <% last = [ request.ends_on, days.last ].min %>
              <span class="timeline__bar timeline__bar--<%= request.pending? ? "waiting" : request.kind %>" style="grid-column: <%= first.day %> / <%= last.day + 1 %>" title="<%= t("enums.time_off_kind_short.#{request.kind}") %><%= " (#{t("time_off.waiting_short")})" if request.pending? %>"><%= t("enums.time_off_kind_short.#{request.kind}") %></span>
            <% end %>
            <% if days.include?(Date.current) %><b class="timeline__today" style="grid-column: <%= Date.current.day %>"></b><% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>
