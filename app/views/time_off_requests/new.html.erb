<% breadcrumbs [ "Workspace", root_path ], [ "Time off", time_off_requests_path ], "Request" %>
<% content_for :content_class, "shell__content--bare" %>
<% first_day = @month.beginning_of_month %>
<% leading = (first_day.wday - 1) % 7 %>
<% balances = TimeOffRequest::KINDS.index_with { |kind| TimeOffRequest.balance_for(Current.user, kind) } %>

<%= form_with model: @request, url: time_off_requests_path, class: "split", data: { controller: "range-calendar ", range_calendar_balances_value: balances.transform_values(&:left).to_json } do |form| %>
  <section class="panel panel--form">
    <header class="panel__bar">
      <%= link_to time_off_requests_path, class: "thread__back", data: { hotkey: "escape" } do %><%= icon "arrow-left" %><span>Back to time off</span><%= render "shared/key", label: "Esc" %><% end %>
    </header>

    <div class="form">
      <header class="form__heading"><h1>Request time off</h1><p>Your approver gets an email and you hear back when they decide.</p></header>

      <div class="calendar__head">
        <%= link_to icon("chevron-left"), new_time_off_request_path(month: (@month - 1.month).strftime("%Y-%m")), class: "pager__button pager__button--box", aria: { label: "Previous month" } %>
        <%= link_to icon("chevron-right"), new_time_off_request_path(month: (@month + 1.month).strftime("%Y-%m")), class: "pager__button pager__button--box", aria: { label: "Next month" } %>
        <h2><%= @month.strftime("%B %Y") %></h2>
      </div>

      <div class="calendar" role="grid">
        <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |name| %><span class="calendar__dow"><%= name %></span><% end %>
        <% leading.times do %><span class="calendar__day calendar__day--blank"></span><% end %>
        <% (first_day..first_day.end_of_month).each do |day| %>
          <% away = @away[day] %>
          <button type="button" class="calendar__day <%= "calendar__day--weekend" if day.on_weekend? %> <%= "calendar__day--today" if day == Date.current %>" data-date="<%= day.iso8601 %>"
                  data-range-calendar-target="day" data-action="range-calendar#pick" <%= "disabled" if day < Date.current %>>
            <span class="calendar__num"><%= day.day %></span>
            <% away.first(2).each do |user, status| %>
              <span class="calendar__away"><%= avatar(user, size: :sm) %><%= status == "pending" ? "Waiting" : "Away" %></span>
            <% end %>
          </button>
        <% end %>
      </div>
      <%= form.hidden_field :starts_on, data: { range_calendar_target: "start" } %>
      <%= form.hidden_field :ends_on, data: { range_calendar_target: "end" } %>
    </div>

    <footer class="panel__footer">
      <%= link_to time_off_requests_path, class: "btn" do %><span>Cancel</span><%= render "shared/key", label: "Esc" %><% end %>
      <button type="submit" class="btn btn--primary" data-range-calendar-target="submit" disabled data-hotkey="ctrl+enter"><%= icon "send" %><span>Send request</span><%= render "shared/key", label: "Ctrl Enter" %></button>
    </footer>
  </section>

  <aside class="side side--wide side--padded">
    <fieldset class="field">
      <legend class="eyebrow">Type</legend>
      <div class="choice">
        <% TimeOffRequest::KINDS.each do |kind| %>
          <label class="choice__option"><%= form.radio_button :kind, kind, class: "choice__input", data: { action: "range-calendar#update", range_calendar_target: "kind" } %><span><%= kind.capitalize %></span></label>
        <% end %>
      </div>
    </fieldset>

    <div class="summary">
      <div class="summary__top"><strong data-range-calendar-target="range">Pick your first day</strong><span data-range-calendar-target="days"></span></div>
      <p data-range-calendar-target="left">Click a start date, then an end date.</p>
    </div>

    <div class="field">
      <%= label_tag :approver_id, "Approver", class: "eyebrow" %>
      <%= select_tag :approver_id, options_for_select(@approvers.map { |user| [ "#{user.short_name} · #{user.role_in(Current.workspace)}", user.id ] }), class: "select", prompt: "Choose an approver" %>
    </div>
  </aside>
<% end %>
