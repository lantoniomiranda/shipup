<%# ShipUp staff shell: a lean top bar, no tenant context. Nested inside layouts/application. %>
<% content_for :app_content do %>
  <div class="shell shell--backoffice">
    <header class="top-bar">
      <div class="top-bar__left">
        <%= link_to backoffice_root_path, class: "brand" do %>
          <span class="brand__mark" aria-hidden="true"><span class="brand__ring"></span></span>
          <span class="brand__word"><%= Rails.configuration.x.product_name %></span>
        <% end %>
        <span class="tag tag--staff">Backoffice</span>
        <nav class="bo-nav" aria-label="Backoffice">
          <%= link_to "Dashboard", backoffice_root_path, class: "bo-nav__item #{"bo-nav__item--active" if current_page?(backoffice_root_path)}" %>
          <%= link_to "Tenants", backoffice_tenants_path, class: "bo-nav__item #{"bo-nav__item--active" if request.path.start_with?(backoffice_tenants_path)}" %>
        </nav>
      </div>
      <div class="top-bar__right">
        <% if Current.user.workspaces.any? %><%= link_to "Open the app", root_path, class: "btn btn--small" %><% end %>
        <%= avatar(Current.user, size: :lg, class: "avatar--ringed") %>
        <%= button_to sign_out_path, method: :delete, class: "btn btn--small", form: { class: "inline-form" } do %><%= icon "arrow-left", size: 13 %><span>Sign out</span><% end %>
      </div>
    </header>
    <%= render "layouts/flash" %>
    <div class="shell__frame"><div class="shell__content"><%= yield %></div></div>
  </div>
<% end %>
<%= render template: "layouts/application" %>
