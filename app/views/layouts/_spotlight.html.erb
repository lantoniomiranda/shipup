<%# Quick-search palette. Opens with "/" or Ctrl/Cmd+Space; results stream into a turbo frame. %>
<div class="spotlight" hidden data-spotlight-target="root" data-action="click->spotlight#backdrop">
  <div class="spotlight__panel" role="dialog" aria-label="<%= t("search.label") %>" aria-modal="true">
    <div class="spotlight__bar">
      <%= icon "search", size: 20 %>
      <input type="search" class="spotlight__input" placeholder="<%= t("search.placeholder") %>" autocomplete="off" data-spotlight-target="input" data-action="input->spotlight#search">
      <kbd class="key">Esc</kbd>
    </div>
    <%= turbo_frame_tag "search_results", data: { spotlight_target: "frame" } %>
    <footer class="spotlight__footer">
      <span><kbd class="key">Enter</kbd> <%= t("search.open") %></span><span><kbd class="key">↑</kbd><kbd class="key">↓</kbd> <%= t("search.move") %></span><span><kbd class="key">Tab</kbd> <%= t("search.switch_filter") %></span>
    </footer>
  </div>
</div>
