<%# The signed-in shell: top bar plus a framed content panel. Nested inside layouts/application. %>
<% content_for :app_content do %>
  <div class="shell" data-controller="spotlight shortcuts" data-spotlight-url-value="<%= search_path(project: @project&.key) %>" data-spotlight-key-value="<%= Keybindings.keys(:search) %>" data-action="keydown@window->spotlight#keydown">
    <%= render "layouts/top_bar" %>
    <%= render "layouts/spotlight" %>
    <%= render "layouts/keyhelp" %>
    <%= yield :project_header %>
    <div class="shell__frame">
      <div class="shell__content <%= yield(:content_class) %>">
        <%= content_for?(:settings_body) ? yield(:settings_body) : yield %>
      </div>
    </div>
  </div>
<% end %>
<%= render template: "layouts/application" %>
