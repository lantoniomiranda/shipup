<% user = Current.user %>
<% running = user.running_time_entry %>
<% unread = user.notifications.unread.exists? %>

<header class="top-bar">
  <div class="top-bar__left">
    <%= link_to root_path, class: "brand", title: "#{t("nav.projects")}", data: hotkey_data(:projects) do %>
      <%= render "shared/logo_mark" %>
      <span class="brand__word">oh, ship!</span>
    <% end %>

    <span class="top-bar__divider"></span>
    <nav class="crumbs" aria-label="<%= t("nav.breadcrumb") %>">
      <%= content_for?(:breadcrumbs) ? yield(:breadcrumbs) : tag.span(t("nav.projects"), class: "crumb crumb--current") %>
    </nav>
  </div>

  <div class="clocks" data-controller="clock">
    <% user.clock_zones.each do |zone| %>
      <div class="clock" data-clock-target="zone" data-zone="<%= zone %>" title="<%= zone %>">
        <%= icon daypart_icon(zone), size: 14 %>
        <strong><%= zone.split("/").last.tr("_", " ") %></strong>
        <span data-clock-target="time"><%= local_time(zone) %></span>
      </div>
    <% end %>
  </div>

  <div class="top-bar__right">
    <button type="button" class="hint hint--button" data-action="click->spotlight#openFromTopBar" aria-label="<%= t("nav.search") %>"><%= t("nav.search") %> <%= key_hint(:search) %></button>
    <button type="button" class="icon-button icon-button--search" data-action="click->spotlight#openFromTopBar" aria-label="<%= t("nav.search") %>" title="<%= t("nav.search") %>"><%= icon "search", size: 18 %></button>
    <button type="button" class="icon-button" data-action="click->shortcuts#toggle" data-hotkey="<%= Keybindings.keys(:help) %>" aria-label="<%= t("nav.keyboard") %>" title="<%= t("nav.keyboard") %>"><%= icon "keyboard", size: 18 %></button>

    <% if running %>
      <div class="timer-pill">
        <span class="timer-pill__dot"></span>
        <span><span class="timer-pill__key"><%= running.task.key %> · </span><span data-controller="stopwatch" data-stopwatch-started-value="<%= running.started_at.iso8601 %>"><%= Time.at(running.seconds).utc.strftime("%H:%M:%S") %></span></span>
      </div>
    <% end %>

    <%= link_to time_off_requests_path, class: "icon-button", aria: { label: t("nav.time_off") }, title: "#{t("nav.time_off")}", data: hotkey_data(:time_off) do %><%= icon "calendar", size: 18 %><% end %>

    <%= link_to notifications_path, class: "icon-button", aria: { label: "#{t("nav.notifications")}#{" (#{t("nav.unread")})" if unread}" }, title: "#{t("nav.notifications")}", data: hotkey_data(:notifications) do %>
      <%= icon "bell", size: 18 %>
      <% if unread %><span class="icon-button__dot"></span><% end %>
    <% end %>

    <%= link_to avatar(user, size: :lg, class: "avatar--ringed"), account_path, aria: { label: t("nav.account") }, title: "#{t("nav.account")}", data: hotkey_data(:account) %>
  </div>
</header>

<%= render "layouts/flash" %>
