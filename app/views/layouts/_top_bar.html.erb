<% user = Current.user %>
<% running = user.running_time_entry %>
<% unread = user.notifications.unread.exists? %>

<header class="top-bar" data-controller="hotkey">
  <div class="top-bar__left">
    <%= link_to root_path, class: "brand" do %>
      <span class="brand__mark" aria-hidden="true"><span class="brand__ring"></span></span>
      <span class="brand__word"><%= Rails.configuration.x.product_name %></span>
    <% end %>

    <nav class="workspaces" aria-label="Workspaces">
      <% user.workspaces.order(:id).each_with_index do |workspace, index| %>
        <span class="workspaces__item <%= "workspaces__item--current" if workspace == Current.workspace %>" title="<%= workspace.name %>"><%= index + 1 %></span>
      <% end %>
    </nav>

    <span class="top-bar__divider"></span>
    <nav class="crumbs" aria-label="Breadcrumb">
      <%= content_for?(:breadcrumbs) ? yield(:breadcrumbs) : tag.span("Projects", class: "crumb crumb--current") %>
    </nav>
  </div>

  <div class="clocks" data-controller="clock">
    <% Current.workspace.clock_zones(for_user: user).each do |zone| %>
      <div class="clock" data-clock-target="zone" data-zone="<%= zone %>">
        <%= icon daypart_icon(zone), size: 14 %>
        <strong><%= zone.split("/").last.tr("_", " ") %></strong>
        <span data-clock-target="time"><%= local_time(zone) %></span>
      </div>
    <% end %>
  </div>

  <div class="top-bar__right">
    <button type="button" class="hint hint--button" data-action="click->spotlight#openFromTopBar" aria-label="Search">Go to <%= render "shared/key", label: "Super Space" %></button>

    <% if running %>
      <div class="timer-pill">
        <span class="timer-pill__dot"></span>
        <span><%= running.task.key %> · <span data-controller="stopwatch" data-stopwatch-started-value="<%= running.started_at.iso8601 %>"><%= Time.at(running.seconds).utc.strftime("%H:%M:%S") %></span></span>
        <kbd class="key key--dark">Shift P</kbd>
      </div>
    <% end %>

    <%= link_to time_off_requests_path, class: "icon-button", aria: { label: "Time off" }, title: "Time off" do %><%= icon "calendar", size: 18 %><% end %>

    <button type="button" class="icon-button" aria-label="Notifications">
      <%= icon "bell", size: 18 %>
      <% if unread %><span class="icon-button__dot"></span><% end %>
    </button>

    <%= link_to avatar(user, size: :lg, class: "avatar--ringed"), account_path, aria: { label: "Account" } %>
  </div>
</header>

<% if notice || alert %>
  <div class="toast toast--<%= notice ? "notice" : "alert" %>" role="status" data-controller="toast">
    <%= icon notice ? "circle-check" : "circle-alert", size: 18 %><span><%= notice || alert %></span>
  </div>
<% end %>
