<%# Keyboard shortcut cheat sheet from config/keybindings.yml, showing the signed-in person's own keys. Open with "?". %>
<div class="keyhelp" hidden data-shortcuts-target="root" data-action="click->shortcuts#backdrop">
  <div class="keyhelp__panel" role="dialog" aria-label="<%= t("shortcuts.title") %>" aria-modal="true">
    <header>
      <h2><%= t("shortcuts.title") %></h2>
      <span><%= link_to t("shortcuts.customize", default: "Customize"), keyboard_settings_path, class: "btn btn--small" %>
      <button type="button" class="icon-button icon-button--small" data-action="shortcuts#close" aria-label="<%= t("shortcuts.close") %>"><%= icon "x", size: 16 %></button></span>
    </header>
    <div class="keyhelp__groups">
      <% Keybindings.by_context.except(:sign_in).each do |context, entries| %>
        <section>
          <h3 class="eyebrow"><%= Keybindings::CONTEXTS.dig(context, :title) %></h3>
          <dl>
            <% entries.each do |entry| %>
              <div><dt><%= entry[:label] %></dt><dd><kbd class="key"><%= Keybindings.label(entry[:id]) %></kbd></dd></div>
            <% end %>
          </dl>
        </section>
      <% end %>
    </div>
    <p class="keyhelp__note"><%= t("shortcuts.note") %></p>
  </div>
</div>
