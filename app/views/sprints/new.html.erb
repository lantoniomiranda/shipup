<% project_header @project, active: :backlog %>
<% active = @project.active_sprint %>

<%= form_with model: [ @project, @sprint ], class: "split" do |form| %>
  <section class="panel panel--form">
    <header class="panel__bar">
      <%= link_to project_backlog_path(@project), class: "thread__back", data: { **hotkey_data(:back) } do %><%= icon "arrow-left" %><span><%= t("sprints.back") %></span><%= key_hint(:back) %><% end %>
    </header>

    <div class="form">
      <header class="form__heading"><h1><%= t("sprints.new", name: @sprint.name) %></h1><p><%= t("sprints.intro") %></p></header>
      <% if @sprint.errors.any? %><p class="flash flash--alert"><%= @sprint.errors.full_messages.to_sentence %></p><% end %>

      <div class="field">
        <%= form.label :goal, t("common.goal"), class: "eyebrow" %>
        <%= form.text_field :goal, class: "input input--title", placeholder: t("sprints.goal_placeholder"), autofocus: true, autocomplete: "off" %>
      </div>

      <div class="field-row">
        <div class="field"><%= form.label :starts_on, t("sprints.starts"), class: "eyebrow" %><%= form.date_field :starts_on, class: "input", required: true %></div>
        <div class="field"><%= form.label :ends_on, t("sprints.ends"), class: "eyebrow" %><%= form.date_field :ends_on, class: "input", required: true %></div>
      </div>

      <label class="check-card">
        <%= hidden_field_tag :start_now, "0", id: nil %>
        <%= check_box_tag :start_now, "1", true, class: "check" %>
        <span><%= active ? t("sprints.start_now_completes", name: active.name) : t("sprints.start_now") %></span>
      </label>

      <% if active %>
        <label class="check-card">
          <%= hidden_field_tag :carry_over, "0", id: nil %>
          <%= check_box_tag :carry_over, "1", true, class: "check" %>
          <span><%= t("sprints.carry", name: active.name) %></span>
        </label>
      <% end %>
    </div>

    <footer class="panel__footer">
      <%= link_to project_backlog_path(@project), class: "btn" do %><span><%= t("common.cancel") %></span><%= key_hint(:back) %><% end %>
      <button type="submit" class="btn btn--primary" data-hotkey="<%= Keybindings.keys(:submit) %>"><%= icon "flag" %><span><%= t("sprints.create", name: @sprint.name) %></span><%= key_hint(:submit) %></button>
    </footer>
  </section>
<% end %>
