<% product = Rails.configuration.x.product_name %>
<% role = t("roles.#{@invitation.role}") %>
<%= t("mailer.join", project: @project.name, product: product) %>

<%= @inviter ? t("mailer.invited_by", name: @inviter.name, role: role, project: @project.name) : t("mailer.invited", role: role, project: @project.name) %>

<%= t("mailer.no_password", email: @invitation.email) %>

<%= sign_in_url %>
