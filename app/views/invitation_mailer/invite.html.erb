<% product = Rails.configuration.x.product_name %>
<% role = t("roles.#{@invitation.role}") %>
<h1 style="font-size:24px;margin:0 0 12px"><%= t("mailer.join", project: @project.name, product: product) %></h1>
<p><%= @inviter ? t("mailer.invited_by", name: @inviter.name, role: role, project: @project.name) : t("mailer.invited", role: role, project: @project.name) %></p>
<p><%= t("mailer.no_password", email: @invitation.email) %></p>
<p><a href="<%= sign_in_url %>" style="display:inline-block;padding:12px 18px;background:#E8632B;color:#2B211A;font-weight:600;text-decoration:none;border-radius:2px"><%= t("mailer.sign_in", product: product) %></a></p>
