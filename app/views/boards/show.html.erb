<% project_header @project, active: :board %>
<% sprint = @board.sprint %>
<% lit = (@board.progress_percent * 16 / 100.0).ceil %>

<div class="board-page" data-controller="board " data-board-token-value="<%= form_authenticity_token %>" data-board-keys-value="<%= board_keys.to_json %>">
  <div class="toolbar">
    <div class="toolbar__sprint">
      <% if sprint %>
        <h1><%= short_date(sprint.starts_on) %> – <%= short_date(sprint.ends_on) %></h1>
        <div class="xp xp--inline">
          <div class="xp__bar xp__bar--small" role="progressbar" aria-valuenow="<%= @board.progress_percent %>" aria-valuemin="0" aria-valuemax="100">
            <% 16.times do |segment| %><span class="xp__segment <%= "xp__segment--on" if segment < lit %> <%= "xp__segment--edge" if segment == lit - 1 %>"></span><% end %>
          </div>
          <span class="toolbar__points"><%= t("board.points", done: @board.done_points, total: @board.total_points) %></span>
        </div>
      <% else %>
        <h1><%= t("board.none") %></h1>
      <% end %>
    </div>
    <% if @project.managed_by?(Current.user) %>
      <% if sprint %>
        <%= button_to complete_project_sprint_path(@project, sprint), method: :patch, class: "btn", form: { class: "inline-form" }, data: { turbo_confirm: t("board.confirm_complete", name: sprint.name) } do %><%= icon "check" %><span><%= t("board.complete") %></span><% end %>
      <% else %>
        <% planned = @project.sprints.upcoming.first %>
        <% if planned %>
          <%= button_to start_project_sprint_path(@project, planned), method: :patch, class: "btn btn--primary", form: { class: "inline-form" } do %><%= icon "play" %><span><%= t("backlog.start") %> · <%= planned.name %></span><% end %>
        <% end %>
        <%= link_to new_project_sprint_path(@project), class: "btn btn--primary" do %><%= icon "flag" %><span><%= t("board.start") %></span><% end %>
      <% end %>
    <% end %>
  </div>

  <div class="columns">
    <% @board.columns.each do |column| %>
      <section class="column <%= "column--focus" if column.status == "in_progress" %>" data-board-target="column" data-status="<%= column.status %>"
               data-action="dragover->board#dragOver dragleave->board#dragLeave drop->board#drop">
        <header class="column__header">
          <span class="column__pip column__pip--<%= column.pip %>"></span>
          <h2><%= column.label %></h2>
          <span class="column__count"><%= column.tasks.size %></span>
        </header>

        <% visible = column.status == "done" ? column.tasks.first(3) : column.tasks %>
        <% visible.each do |task| %>
          <%= render "boards/card", task: task, project: @project, running: task.id == @running_task_id %>
        <% end %>
        <% hidden = column.tasks.size - visible.size %>
        <% if hidden.positive? %><p class="column__more"><%= t("board.more", count: hidden) %></p><% end %>
      </section>
    <% end %>
  </div>

</div>
