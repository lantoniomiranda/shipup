<%# A task on the board. `running` marks the card the signed-in user is timing. %>
<% done = task.done? %>
<% chain = task.chain %>
<% label = task.labels.first %>
<% pull_request = task.pull_requests.first %>
<% estimate_hours = task.estimate_minutes && (task.estimate_minutes / 60.0).round %>
<article class="card <%= "card--done" if done %> <%= "card--running" if running %>" tabindex="0" draggable="true"
         data-board-target="card" data-action="dragstart->board#dragStart dragend->board#dragEnd"
         data-task-url="<%= project_task_path(project, task) %>" data-next-status="<%= task.next_status %>">
  <div class="card__top">
    <span class="card__key"><%= task.key %></span>
    <% if done %>
      <span class="card__done"><%= icon "circle-check", size: 14 %></span>
    <% elsif task.topic %>
      <%= link_to project_topic_path(project, task.topic), class: "card__topic", draggable: false do %><%= icon "message-square", size: 12 %><%= t("tasks.from_discussion", id: task.topic.id) %><% end %>
    <% end %>
  </div>

  <%= link_to task.title, project_task_path(project, task), class: "card__title", draggable: false %>

  <% if chain && chain.tasks.size > 1 %>
    <% following = task.next_in_chain %>
    <div class="chain-strip">
      <div class="chain-strip__row">
        <%= icon "layers", size: 13 %><span><%= t("tasks.step_of", position: task.chain_position, size: task.chain_size, title: task.title.split.first) %></span>
        <span class="dots"><% task.chain_size.times do |index| %><i class="dots__dot <%= "dots__dot--on" if index < task.chain_position %>"></i><% end %></span>
      </div>
      <% if following %><p class="chain-strip__hint"><%= icon "lock", size: 12 %><%= t("tasks.unlocks_next", title: following.title.split.first) %></p><% end %>
    </div>
  <% end %>

  <% if running %>
    <div class="card__timer"><span class="card__timer-dot"></span><span data-controller="stopwatch" data-stopwatch-started-value="<%= task.time_entries.running.first.started_at.iso8601 %>">00:00:00</span><%= icon "git-branch", size: 13 %></div>
  <% else %>
    <div class="card__time <%= "card__time--over" if task.over_estimate? %>">
      <%= icon "timer", size: 13 %>
      <span><% hours = (task.logged_minutes / 60.0).round %><%= done ? t("tasks.hours_logged", hours: hours) : (estimate_hours ? t("tasks.hours_of", logged: hours, estimate: estimate_hours) : t("tasks.hours_only", hours: hours)) %></span>
      <% if pull_request %>
        <span class="card__pr"><%= icon "git-branch", size: 13 %><%= icon(pull_request.merged? ? "git-merge" : "git-pull-request", size: 13) %>#<%= pull_request.number %></span>
      <% else %>
        <%= icon "git-branch", size: 13 %>
      <% end %>
    </div>
  <% end %>

  <div class="card__footer">
    <% if label %><span class="tag tag--label hue-<%= label.color %>"><%= label.name %></span><% else %><span></span><% end %>
    <span class="card__meta <%= "card__meta--late" if task.overdue? %>">
      <% if task.due_on %><%= short_date(task.due_on) %><% end %>
      <% if task.assignee %><%= avatar(task.assignee, size: :sm) %><% end %>
    </span>
  </div>
</article>
