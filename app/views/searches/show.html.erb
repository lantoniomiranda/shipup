<%= turbo_frame_tag "search_results" do %>
  <% results = @search.results %>
  <nav class="spotlight__tabs" aria-label="<%= t("search.scope") %>">
    <% [ [ "everything", t("search.everything"), nil ], [ "pages", t("search.pages"), @counts["pages"] ], [ "topics", t("search.topics"), @counts["topics"] ], [ "tasks", t("search.tasks"), @counts["tasks"] ], [ "chains", t("search.chains"), @counts["chains"] ], [ "projects", t("search.projects"), @counts["projects"] ] ].each do |key, label, count| %>
      <%= link_to search_path(q: @search.query, scope: key, project: @search.project&.key), class: "spotlight__tab #{"spotlight__tab--active" if @search.scope == key}", data: { spotlight_target: "tab", turbo_frame: "search_results" } do %><%= label %><%= " #{count}" if count && @search.query.present? %><% end %>
    <% end %>
  </nav>

  <div class="spotlight__list">
    <% if @search.query.blank? %>
      <p class="spotlight__hint"><%= t("search.hint_html", example: "APO-97") %></p>
    <% elsif results.empty? %>
      <p class="spotlight__hint"><%= t("search.empty", query: @search.query) %></p>
    <% end %>

    <% if results.pages.any? %>
      <h4 class="eyebrow"><%= t("search.pages") %></h4>
      <% results.pages.each do |page| %>
        <%= link_to page.path, class: "spotlight__result", data: { spotlight_target: "result", turbo_frame: "_top" } do %>
          <%= icon page.icon, size: 18 %>
          <span class="spotlight__text"><strong><%= page.title %></strong><small><%= page.hint %></small></span>
        <% end %>
      <% end %>
    <% end %>

    <% mine = [ [ "topic", results.in_project(results.topics) ], [ "task", results.in_project(results.tasks) ], [ "chain", results.in_project(results.chains) ] ] %>
    <% if mine.any? { |_, records| records.any? } %>
      <h4 class="eyebrow"><%= t("search.in_project", project: @search.project.name) %></h4>
      <% mine.each do |kind, records| %>
        <% records.each do |record| %><%= render "searches/#{kind}", kind.to_sym => record %><% end %>
      <% end %>
    <% end %>

    <% { "topic" => results.topics, "task" => results.tasks, "chain" => results.chains }.each do |kind, records| %>
      <% others = results.elsewhere(records) %>
      <% if others.any? %>
        <h4 class="eyebrow"><%= t("search.#{kind}s") %></h4>
        <% others.each do |record| %><%= render "searches/#{kind}", kind.to_sym => record %><% end %>
      <% end %>
    <% end %>

    <% if results.projects.any? %>
      <h4 class="eyebrow"><%= t("search.projects") %></h4>
      <% results.projects.each do |project| %>
        <%= link_to project_topics_path(project), class: "spotlight__result", data: { spotlight_target: "result" } do %>
          <%= icon project.icon, size: 18 %>
          <span class="spotlight__text"><strong><%= project.name %></strong><small><%= project.key %> · <%= project.description %></small></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
