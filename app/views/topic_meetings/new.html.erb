<% project_header @project, active: :topics %>
<% provider = Setting.meeting_provider %>

<%= form_with url: project_topic_meetings_path(@project, @topic), class: "split", data: { controller: "meeting-form" } do |form| %>
  <section class="panel panel--form">
    <header class="panel__bar">
      <%= link_to project_topic_path(@project, @topic), class: "thread__back", data: { hotkey: "escape" } do %>
        <%= icon "arrow-left" %><span><%= t("tasks.back_to_topic") %></span><%= render "shared/key", label: "Esc" %>
      <% end %>
    </header>

    <div class="form">
      <header class="form__heading">
        <h1><%= t("meetings.title") %></h1>
        <p><%= t("meetings.link_note", title: @topic.title) %></p>
      </header>

      <% unless provider %>
        <p class="flash flash--alert"><%= t("meetings.none_html", link: link_to(t("meetings.set_up"), integrations_path, class: "link")) %></p>
      <% end %>

      <div class="field-row field-row--wide">
        <div class="field field--grow-x">
          <%= label_tag :starts_at, t("meetings.when"), class: "eyebrow" %>
          <select name="starts_at" id="starts_at" class="select select--icon" data-meeting-form-target="when" data-action="meeting-form#recenter">
            <% @slots.each do |slot| %>
              <option value="<%= slot.starts_at.iso8601 %>"><%= slot.label(30) %> <%= t("meetings.covered", covered: slot.covered, total: slot.total) %></option>
            <% end %>
          </select>
        </div>
        <div class="field">
          <%= label_tag :duration_minutes, t("meetings.length"), class: "eyebrow" %>
          <%= select_tag :duration_minutes, options_for_select([ 30, 45, 60 ].map { |minutes| [ t("meetings.minutes", count: minutes), minutes ] }), class: "select" %>
        </div>
        <div class="field">
          <p class="eyebrow"><%= t("meetings.recording") %></p>
          <label class="check-card">
            <%= hidden_field_tag :transcribe, "0" %>
            <%= check_box_tag :transcribe, "1", true, class: "check" %>
            <span><%= t("meetings.transcribe") %></span>
          </label>
        </div>
      </div>

      <div class="field">
        <p class="eyebrow"><%= t("meetings.invite", count: @invitees.size) %></p>
        <ul class="invitees">
          <% @invitees.each do |user, reason| %>
            <% in_topic = reason != t("meetings.not_in_topic") %>
            <li class="invitee <%= "invitee--off" unless in_topic %>">
              <%= hidden_field_tag "attendees[#{user.id}][invite]", "0" %>
              <%= check_box_tag "attendees[#{user.id}][invite]", "1", in_topic, class: "check", "aria-label": t("meetings.invite_person", name: user.name) %>
              <%= avatar(user, size: :md) %>
              <span class="invitee__name"><strong><%= user.short_name %></strong><small><%= reason %></small></span>
              <span class="invitee__time"><%= icon daypart_icon(user.time_zone), size: 13 %><%= local_time(user.time_zone) %> <%= user.city %></span>
              <span class="choice choice--small">
                <label class="choice__option"><%= radio_button_tag "attendees[#{user.id}][requirement]", "required", true, class: "choice__input" %><span><%= t("common.required") %></span></label>
                <label class="choice__option choice__option--optional"><%= radio_button_tag "attendees[#{user.id}][requirement]", "optional", false, class: "choice__input" %><span><%= t("common.optional") %></span></label>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <footer class="panel__footer">
      <%= link_to project_topic_path(@project, @topic), class: "btn" do %><span><%= t("common.cancel") %></span><%= render "shared/key", label: "Esc" %><% end %>
      <button type="submit" class="btn btn--primary" <%= "disabled" unless provider %> data-hotkey="ctrl+enter">
        <%= icon "video" %><span><%= t("meetings.create") %></span><%= render "shared/key", label: "Ctrl Enter" %>
      </button>
    </footer>
  </section>

  <aside class="side side--wide side--padded">
    <%= render "shared/topic_summary", topic: @topic, heading: t("meetings.topic") %>

    <div class="field">
      <p class="eyebrow"><%= t("meetings.hours") %></p>
      <ul class="hours" data-meeting-form-target="hours">
        <% @invitees.first(4).each do |user, _reason| %>
          <li>
            <div class="hours__head"><strong><%= user.short_name %></strong><span><%= user.city %></span></div>
            <div class="hours__bar">
              <% working_hour_segments(user).each do |left, width| %>
                <span class="hours__work" style="left: <%= left %>%; width: <%= width %>%"></span>
              <% end %>
              <span class="hours__now"></span>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </aside>
<% end %>
