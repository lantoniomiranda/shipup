<% project_header @project, active: :topics %>
<% provider = Current.workspace.meeting_provider %>

<%= form_with url: project_topic_meetings_path(@project, @topic), class: "split", data: { controller: "meeting-form", meeting_form_zone_value: Current.user.time_zone } do |form| %>
  <section class="panel panel--form">
    <header class="panel__bar">
      <%= link_to project_topic_path(@project, @topic), class: "thread__back", data: { **hotkey_data(:back) } do %>
        <%= icon "arrow-left" %><span>Back to topic</span><%= key_hint(:back) %>
      <% end %>
    </header>

    <div class="form">
      <header class="form__heading">
        <h1>Discuss this topic live</h1>
        <p><%= @topic.title %>. The link is posted in the topic chat.</p>
      </header>

      <% unless provider %>
        <p class="flash flash--alert">No meeting tool is connected yet. <%= link_to "Set one up", integrations_path, class: "link" %> (workspace admins only).</p>
      <% end %>

      <div class="field-row field-row--wide">
        <div class="field">
          <%= label_tag :date, "Date", class: "eyebrow" %>
          <%= date_field_tag :date, @default_start.to_date, min: Date.current, required: true, class: "input",
                             data: { meeting_form_target: "date", action: "input->meeting-form#recompute" } %>
        </div>
        <div class="field">
          <%= label_tag :time, "Time", class: "eyebrow" %>
          <%= time_field_tag :time, @default_start.strftime("%H:%M"), step: 300, required: true, class: "input",
                             data: { meeting_form_target: "time", action: "input->meeting-form#recompute" } %>
        </div>
        <div class="field">
          <%= label_tag :duration_minutes, "Length", class: "eyebrow" %>
          <%= select_tag :duration_minutes, options_for_select([ [ "30 min", 30 ], [ "45 min", 45 ], [ "60 min", 60 ] ]), class: "select" %>
        </div>
        <div class="field">
          <p class="eyebrow">Recording</p>
          <label class="check-card">
            <%= hidden_field_tag :transcribe, "0" %>
            <%= check_box_tag :transcribe, "1", true, class: "check" %>
            <span>Transcribe and add a digest to the topic</span>
          </label>
        </div>
      </div>

      <div class="field">
        <p class="eyebrow">Suggested times · best overlap of working hours</p>
        <div class="chips chips--wrap">
          <% @slots.each do |slot| %>
            <% local = slot.starts_at.in_time_zone %>
            <button type="button" class="chip" data-action="meeting-form#pick" data-meeting-form-date-param="<%= local.to_date.iso8601 %>" data-meeting-form-time-param="<%= local.strftime("%H:%M") %>">
              <%= local.strftime("%a %-d %b · %H:%M") %> · <%= slot.covered %>/<%= slot.total %> available
            </button>
          <% end %>
        </div>
        <p class="meeting-when" data-meeting-form-target="summary" role="status">Times are in your time zone, <%= Current.user.time_zone.tr("_", " ") %> (UTC<%= Time.zone.now.formatted_offset %>).</p>
      </div>

      <div class="field">
        <p class="eyebrow"><%= "Invite · #{pluralize(@invitees.size, "person")}" %></p>
        <ul class="invitees">
          <% @invitees.each do |user, reason| %>
            <% in_topic = reason != "Not in this topic" %>
            <% prefs = user.preference %>
            <li class="invitee <%= "invitee--off" unless in_topic %>" data-meeting-form-target="invitee" data-zone="<%= user.time_zone %>"
                data-work-start="<%= prefs.work_day_start.hour * 60 + prefs.work_day_start.min %>" data-work-end="<%= prefs.work_day_end.hour * 60 + prefs.work_day_end.min %>">
              <%= hidden_field_tag "attendees[#{user.id}][invite]", "0" %>
              <%= check_box_tag "attendees[#{user.id}][invite]", "1", in_topic, class: "check", "aria-label": "Invite #{user.name}" %>
              <%= avatar(user, size: :md) %>
              <span class="invitee__name"><strong><%= user.short_name %></strong><small><%= reason %></small></span>
              <span class="invitee__time"><%= icon daypart_icon(user.time_zone), size: 13 %><b data-clock><%= local_time(user.time_zone) %></b> <%= user.city %></span>
              <span class="choice choice--small">
                <label class="choice__option"><%= radio_button_tag "attendees[#{user.id}][requirement]", "required", true, class: "choice__input" %><span>Required</span></label>
                <label class="choice__option choice__option--optional"><%= radio_button_tag "attendees[#{user.id}][requirement]", "optional", false, class: "choice__input" %><span>Optional</span></label>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <footer class="panel__footer">
      <%= link_to project_topic_path(@project, @topic), class: "btn" do %><span>Cancel</span><%= key_hint(:back) %><% end %>
      <button type="submit" class="btn btn--primary" <%= "disabled" unless provider %> data-hotkey="<%= Keybindings.keys(:submit) %>">
        <%= icon "video" %><span>Create and post link</span><%= key_hint(:submit) %>
      </button>
    </footer>
  </section>

  <aside class="side side--wide side--padded">
    <%= render "shared/topic_summary", topic: @topic, heading: "Topic" %>

    <div class="field">
      <p class="eyebrow">Working hours · 24h in UTC</p>
      <ul class="hours" data-meeting-form-target="hours">
        <% @invitees.first(4).each do |user, _reason| %>
          <li>
            <div class="hours__head"><strong><%= user.short_name %></strong><span><%= user.city %></span></div>
            <div class="hours__bar">
              <% working_hour_segments(user).each do |left, width| %>
                <span class="hours__work" style="left: <%= left %>%; width: <%= width %>%"></span>
              <% end %>
              <span class="hours__now"></span>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </aside>
<% end %>
