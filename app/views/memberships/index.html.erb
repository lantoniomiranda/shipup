<% breadcrumbs [ "Workspace", root_path ], "People" %>
<% content_for :title, "People" %>
<% workspace = Current.workspace %>

<header class="page-header">
  <div class="page-header__heading">
    <h1>People</h1>
    <p><%= pluralize(@memberships.size, "member") %><%= " · #{workspace.seats_used} of #{workspace.seats_limit} seats used" if workspace.seats_limit %>. Everyone signs in with Google or Microsoft, so inviting is just an email address.</p>
  </div>
</header>

<%= form_with url: invitations_path, scope: :invitation, class: "invite-bar" do |form| %>
  <%= form.email_field :email, class: "input", placeholder: "name@company.com", required: true, "aria-label": "Email address" %>
  <%= form.select :role, Invitation.roles.keys.map { |role| [ role.capitalize, role ] }, { selected: "member" }, class: "select select--small" %>
  <button type="submit" class="btn btn--primary"><%= icon "user-plus" %><span>Send invitation</span></button>
<% end %>

<section class="panel panel--table panel--inline">
  <table class="table">
    <thead><tr><th>Person</th><th>Role</th><th>Last sign-in</th><th>Joined</th><th></th></tr></thead>
    <tbody>
      <% @memberships.each do |membership| %>
        <% user = membership.user %>
        <tr>
          <td><div class="client-cell"><%= avatar(user, size: :md) %><div><strong><%= user.name %></strong><small><%= user.email %></small></div></div></td>
          <td>
            <%= form_with model: membership, url: membership_path(membership), method: :patch, scope: :membership, class: "role-form" do |form| %>
              <%= form.select :role, Membership.roles.keys.map { |role| [ role.capitalize, role ] }, {}, class: "select select--small", onchange: "this.form.requestSubmit()", "aria-label": "Role of #{user.name}" %>
            <% end %>
          </td>
          <td><%= (seen = @last_seen[user.id]) ? "#{time_ago_in_words(seen)} ago" : "Never" %></td>
          <td><%= membership.created_at.strftime("%b %-d, %Y") %></td>
          <td class="table__actions">
            <% unless user == Current.user %>
              <%= button_to membership_path(membership), method: :delete, class: "btn btn--small", form: { class: "inline-form", data: { turbo_confirm: "Remove #{user.name} from #{workspace.name}?" } } do %><%= icon "x", size: 13 %><span>Remove</span><% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<% if @invitations.any? %>
  <h2 class="section-title">Pending invitations</h2>
  <section class="panel panel--table panel--inline">
    <table class="table">
      <thead><tr><th>Email</th><th>Role</th><th>Invited by</th><th>Sent</th><th></th></tr></thead>
      <tbody>
        <% @invitations.each do |invitation| %>
          <tr>
            <td><strong><%= invitation.email %></strong></td>
            <td><span class="tag"><%= invitation.role.capitalize %></span></td>
            <td><%= invitation.invited_by&.short_name || "ShipUp" %></td>
            <td><%= invitation.created_at.strftime("%b %-d") %></td>
            <td class="table__actions">
              <%= button_to resend_invitation_path(invitation), class: "btn btn--small", form: { class: "inline-form" } do %><span>Resend</span><% end %>
              <%= button_to invitation_path(invitation), method: :delete, class: "btn btn--small", form: { class: "inline-form", data: { turbo_confirm: "Revoke this invitation?" } } do %><span>Revoke</span><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
