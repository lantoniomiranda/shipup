# Copy to .env (git-ignored) and adjust. bin/setup does this for you.
POSTGRES_USER=shipup
POSTGRES_PASSWORD=shipup
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# OAuth sign-in (Google Cloud console / Microsoft Entra app registration).
# Redirect URIs: http://localhost:3000/auth/google_oauth2/callback and
#                http://localhost:3000/auth/entra_id/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Workspace integrations (Setup > Meeting tool, Project > GitHub)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Google Meet reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above (add the Calendar scope and
# the redirect URI http://localhost:3000/integrations/google_meet/callback).

# AI drafts (tasks and chains from a topic). Leave LLM_ENABLED blank to switch AI off.
# One of: claude | gemini | grok | gpt
LLM_ENABLED=
LLM_API_KEY=
# Optional overrides
LLM_MODEL=
LLM_BASE_URL=

# ohship staff who may open /backoffice (comma separated). They can sign in without a workspace.
PLATFORM_ADMIN_EMAILS= # SUPERADMIN_EMAILS works too

# Outgoing email (workspace invitations). Development just logs mail; production needs SMTP.
APP_HOST=
MAIL_FROM=ohship <no-reply@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
